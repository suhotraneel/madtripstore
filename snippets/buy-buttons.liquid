{% comment %}
  Renders product buy-buttons.
  Accepts:
  - product: {Object} product object.
  - block: {Object} passing the block information.
  - product_form_id: {String} product form id.
  - section_id: {String} id of section to which this snippet belongs.
  - show_pickup_availability: {Boolean} for the pickup availability. If true the pickup availability is rendered, false - not rendered (optional).

  Usage:
  {% render 'buy-buttons', block: block, product: product, product_form_id: product_form_id, section_id: section.id, show_pickup_availability: true %}
{% endcomment %}
<div {{ block.shopify_attributes }}>
  {%- if product != blank -%}
    {%- liquid
      assign gift_card_recipient_feature_active = false
      if block.settings.show_gift_card_recipient and product.gift_card?
        assign gift_card_recipient_feature_active = true
      endif

      assign show_dynamic_checkout = false
      if block.settings.show_dynamic_checkout and gift_card_recipient_feature_active == false
        assign show_dynamic_checkout = true
      endif

      assign btn_size_fallback = block.settings.button_size | default: 'small'
    -%}

    <product-form
      class="product-form"
      data-hide-errors="{{ gift_card_recipient_feature_active }}"
      data-section-id="{{ section.id }}"
    >
      <div class="product-form__error-message-wrapper" role="alert" hidden>
        <svg
          aria-hidden="true"
          focusable="false"
          class="icon icon-error"
          viewBox="0 0 13 13"
        >
          <circle cx="6.5" cy="6.50049" r="5.5" stroke="white" stroke-width="2"/>
          <circle cx="6.5" cy="6.5" r="5.5" fill="#EB001B" stroke="#EB001B" stroke-width="0.7"/>
          <path d="M5.87413 3.52832L5.97439 7.57216H7.02713L7.12739 3.52832H5.87413ZM6.50076 9.66091C6.88091 9.66091 7.18169 9.37267 7.18169 9.00504C7.18169 8.63742 6.88091 8.34917 6.50076 8.34917C6.12061 8.34917 5.81982 8.63742 5.81982 9.00504C5.81982 9.37267 6.12061 9.66091 6.50076 9.66091Z" fill="white"/>
          <path d="M5.87413 3.17832H5.51535L5.52424 3.537L5.6245 7.58083L5.63296 7.92216H5.97439H7.02713H7.36856L7.37702 7.58083L7.47728 3.537L7.48617 3.17832H7.12739H5.87413ZM6.50076 10.0109C7.06121 10.0109 7.5317 9.57872 7.5317 9.00504C7.5317 8.43137 7.06121 7.99918 6.50076 7.99918C5.94031 7.99918 5.46982 8.43137 5.46982 9.00504C5.46982 9.57872 5.94031 10.0109 6.50076 10.0109Z" fill="white" stroke="#EB001B" stroke-width="0.7">
        </svg>
        <span class="product-form__error-message"></span>
      </div>

      {%- form 'product',
        product,
        id: product_form_id,
        class: 'form',
        novalidate: 'novalidate',
        data-type: 'add-to-cart-form'
      -%}
        <input
          type="hidden"
          name="id"
          value="{{ product.selected_or_first_available_variant.id }}"
          {% if product.selected_or_first_available_variant.available == false
            or quantity_rule_soldout
            or product.selected_or_first_available_variant == nil
          %}
            disabled
          {% endif %}
          class="product-variant-id"
        >

        {%- if gift_card_recipient_feature_active -%}
          {%- render 'gift-card-recipient-form', product: product, form: form, section: section -%}
        {%- endif -%}

        <div class="product-form__buttons">
          {%- liquid
            assign check_against_inventory = true
            if product.selected_or_first_available_variant.inventory_management != 'shopify' or product.selected_or_first_available_variant.inventory_policy == 'continue'
              assign check_against_inventory = false
            endif
            if product.selected_or_first_available_variant.quantity_rule.min > product.selected_or_first_available_variant.inventory_quantity and check_against_inventory
              assign quantity_rule_soldout = true
            endif
            
            assign is_disabled = false
            if product.selected_or_first_available_variant.available == false or quantity_rule_soldout or product.selected_or_first_available_variant == nil
              assign is_disabled = true
            endif
          -%}
          {%- capture add_to_cart_label -%}
            {%- if product.selected_or_first_available_variant == nil -%}
              {{ 'products.product.unavailable' | t }}
            {%- elsif product.selected_or_first_available_variant.available == false or quantity_rule_soldout -%}
              {{ 'products.product.sold_out' | t }}
            {%- else -%}
              {{ 'products.product.add_to_cart' | t }}
            {%- endif -%}
          {%- endcapture -%}
          {%- capture add_to_cart_suffix -%}
            {%- render 'loading-spinner' -%}
          {%- endcapture -%}
          {%- assign add_to_cart_class = 'product-form__submit' -%}
          {%- if block.settings.mobile_sticky_button == 'add_to_cart' -%}
            {%- assign add_to_cart_class = add_to_cart_class | append: ' hide-on-mobile' -%}
          {%- endif -%}
          {%- assign submit_btn_id = 'ProductSubmitButton-' | append: section_id -%}
          {% render 'button-component',
            is_button: true,
            type: 'submit',
            name: 'add',
            id: submit_btn_id,
            custom_class: add_to_cart_class,
            disabled: is_disabled,
            label: add_to_cart_label,
            suffix_html: add_to_cart_suffix,
            variant: 'secondary',
            size: btn_size_fallback,
            full_width: true
          %}

          {%- if show_dynamic_checkout and is_disabled == false -%}
            <style>
              .dynamic-checkout-buttons-container {
                position: relative;
                margin-top: 1.5rem;
              }
              @media screen and (max-width: 749px) {
                .dynamic-checkout-buttons-container {
                  margin-top: 1rem;
                }
              }
            </style>
            <div id="dynamic-checkout-{{ section_id }}" class="dynamic-checkout-buttons-container{% if block.settings.mobile_sticky_button == 'buy_now' %} hide-on-mobile{% endif %}">
              <div class="shopify-payment-button-wrapper" style="position: absolute; opacity: 0.01; pointer-events: none; z-index: -1;">
                {{ form | payment_button }}
              </div>
              {%- assign buy_now_label = 'Buy Now' -%}
              {% render 'button-component',
                is_button: true,
                type: 'button',
                custom_class: 'custom-buy-it-now',
                label: buy_now_label,
                variant: 'primary',
                size: btn_size_fallback,
                full_width: true
              %}
              <script>
                document.addEventListener('DOMContentLoaded', function() {
                  const container = document.getElementById('dynamic-checkout-{{ section_id }}');
                  if (!container) return;
                  const customBtn = container.querySelector('.custom-buy-it-now');
                  if (customBtn) {
                    customBtn.addEventListener('click', function(e) {
                      e.preventDefault();
                      const realBuyBtn = container.querySelector('.shopify-payment-button__button--unbranded, .shopify-payment-button__button');
                      if (realBuyBtn) {
                        realBuyBtn.click();
                      }
                    });
                  }
                });
              </script>
            </div>
          {%- endif -%}
        </div>
      {%- endform -%}
    </product-form>
  {%- else -%}
    <div class="product-form">
      <div class="product-form__buttons form">
        {%- capture fallback_label -%}{{ 'products.product.sold_out' | t }}{%- endcapture -%}
        {% render 'button-component',
          is_button: true,
          type: 'submit',
          name: 'add',
          custom_class: 'product-form__submit',
          disabled: true,
          label: fallback_label,
          variant: 'secondary',
          size: btn_size_fallback,
          full_width: true
        %}
      </div>
    </div>
  {%- endif -%}

  {%- if show_pickup_availability -%}
    {{ 'component-pickup-availability.css' | asset_url | stylesheet_tag }}

    {%- assign pick_up_availabilities = product.selected_or_first_available_variant.store_availabilities
      | where: 'pick_up_enabled', true
    -%}

    <pickup-availability
      class="product__pickup-availabilities quick-add-hidden"
      {% if product.selected_or_first_available_variant.available and pick_up_availabilities.size > 0 %}
        available
      {% endif %}
      data-root-url="{{ routes.root_url }}"
      data-variant-id="{{ product.selected_or_first_available_variant.id }}"
      data-has-only-default-variant="{{ product.has_only_default_variant }}"
      data-product-page-color-scheme="gradient color-{{ section.settings.color_scheme }}"
    >
      <template>
        <pickup-availability-preview class="pickup-availability-preview">
          {% render 'icon-unavailable' %}
          <div class="pickup-availability-info">
            <p class="caption-large">{{ 'products.product.pickup_availability.unavailable' | t }}</p>
            <button class="pickup-availability-button link link--text underlined-link">
              {{ 'products.product.pickup_availability.refresh' | t }}
            </button>
          </div>
        </pickup-availability-preview>
      </template>
    </pickup-availability>

    <script src="{{ 'pickup-availability.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  {%- if block.settings.mobile_sticky_button and block.settings.mobile_sticky_button != 'none' -%}
    <style>
      .mobile-sticky-button-container {
        display: none;
      }
      @media screen and (max-width: 749px) {
        body {
          padding-bottom: 90px; /* Extra space to prevent the sticky button from covering bottom items */
        }
        .hide-on-mobile {
          display: none !important;
        }
        .mobile-sticky-button-container {
          display: block;
          position: fixed;
          bottom: 0;
          left: 0;
          width: 100%;
          background-color: #111111;
          padding: 16px 24px;
          z-index: 99; /* Stay below preloader */
          box-shadow: 0 -1px 0px rgb(255 255 255 / 20%);
        }
      }
    </style>
    <div class="mobile-sticky-button-container{% if is_disabled %} hidden{% endif %}" id="MobileStickyButtonContainer-{{ section_id }}">
      {%- assign sticky_id = 'MobileStickyButton-' | append: section_id -%}
      {%- if block.settings.mobile_sticky_button == 'add_to_cart' -%}
        {% render 'button-component',
          is_button: true,
          type: 'button',
          custom_class: 'mobile-sticky-btn',
          label: add_to_cart_label,
          variant: 'primary',
          size: btn_size_fallback,
          full_width: true,
          id: sticky_id
        %}
      {%- elsif block.settings.mobile_sticky_button == 'buy_now' -%}
        {%- assign sticky_buy_now_label = 'Buy Now' -%}
        {% render 'button-component',
          is_button: true,
          type: 'button',
          custom_class: 'mobile-sticky-btn',
          label: sticky_buy_now_label,
          variant: 'primary',
          size: btn_size_fallback,
          full_width: true,
          id: sticky_id
        %}
      {%- endif -%}
    </div>
    <script>
      document.addEventListener('DOMContentLoaded', function() {
        const stickyContainer = document.getElementById('MobileStickyButtonContainer-{{ section_id }}');
        if (stickyContainer) {
          document.body.appendChild(stickyContainer);
        }
        const stickyBtn = document.getElementById('MobileStickyButton-{{ section_id }}');
        if (stickyBtn) {
          stickyBtn.addEventListener('click', function(e) {
            e.preventDefault();
            {%- if block.settings.mobile_sticky_button == 'add_to_cart' -%}
              const targetBtn = document.getElementById('ProductSubmitButton-{{ section_id }}');
            {%- elsif block.settings.mobile_sticky_button == 'buy_now' -%}
              const targetBtn = document.querySelector('#dynamic-checkout-{{ section_id }} .custom-buy-it-now') || document.querySelector('.shopify-payment-button__button--unbranded, .shopify-payment-button__button');
            {%- endif -%}
            if (targetBtn) {
              targetBtn.click();
            }
          });
        }
      });
    </script>
  {%- endif -%}
</div>
