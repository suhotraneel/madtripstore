{% doc %}
  @prompt
    testimonial section with horizontal scroll. The text is primary what the person said and there will be there image with their name, 5-6 person, but horizontal scroll, remove the quotation mark from the quote and give that the font of our brand
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-testimonial-scroll-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 60px 0;
    background-color: {{ block.settings.background_color }};
  }

  .ai-testimonial-scroll__container-{{ ai_gen_id }} {
    width: 100%;
    max-width: 100%;
    overflow: hidden;
  }

  .ai-testimonial-scroll__heading-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin: 0 auto 40px;
    padding: 0 20px;
    max-width: 1400px;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
  }

  .ai-testimonial-scroll__wrapper-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.card_gap }}px;
    overflow-x: auto;
    scroll-behavior: smooth;
    padding: 0 20px 20px;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    scrollbar-color: {{ block.settings.scrollbar_color }} transparent;
  }

  .ai-testimonial-scroll__wrapper-{{ ai_gen_id }}::-webkit-scrollbar {
    height: 8px;
  }

  .ai-testimonial-scroll__wrapper-{{ ai_gen_id }}::-webkit-scrollbar-track {
    background: transparent;
  }

  .ai-testimonial-scroll__wrapper-{{ ai_gen_id }}::-webkit-scrollbar-thumb {
    background-color: {{ block.settings.scrollbar_color }};
    border-radius: 4px;
  }

  .ai-testimonial-scroll__card-{{ ai_gen_id }} {
    flex: 0 0 {{ block.settings.card_width }}px;
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .ai-testimonial-scroll__quote-{{ ai_gen_id }} {
    color: {{ block.settings.quote_color }};
    font-size: {{ block.settings.quote_size }}px;
    line-height: 1.6;
    flex-grow: 1;
    font-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
    font-weight: {{ settings.type_body_font.weight }};
    font-style: {{ settings.type_body_font.style }};
  }

  .ai-testimonial-scroll__author-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 15px;
  }

  .ai-testimonial-scroll__image-wrapper-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.image_size }}px;
    height: {{ block.settings.image_size }}px;
    border-radius: 50%;
    overflow: hidden;
    background-color: #f4f4f4;
  }

  .ai-testimonial-scroll__image-wrapper-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-testimonial-scroll__image-wrapper-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-testimonial-scroll__author-info-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .ai-testimonial-scroll__name-{{ ai_gen_id }} {
    color: {{ block.settings.name_color }};
    font-size: {{ block.settings.name_size }}px;
    font-weight: 600;
    margin: 0;
  }

  .ai-testimonial-scroll__title-{{ ai_gen_id }} {
    color: {{ block.settings.title_color }};
    font-size: {{ block.settings.title_size }}px;
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-testimonial-scroll__card-{{ ai_gen_id }} {
      flex: 0 0 {{ block.settings.card_width | times: 0.85 }}px;
    }

    .ai-testimonial-scroll__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<testimonial-scroll-{{ ai_gen_id }} class="ai-testimonial-scroll-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-testimonial-scroll__container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-testimonial-scroll__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    <div class="ai-testimonial-scroll__wrapper-{{ ai_gen_id }}">
      {% for i in (1..6) %}
        {% liquid
          assign quote_key = 'testimonial_' | append: i | append: '_quote'
          assign name_key = 'testimonial_' | append: i | append: '_name'
          assign title_key = 'testimonial_' | append: i | append: '_title'
          assign image_key = 'testimonial_' | append: i | append: '_image'

          assign quote = block.settings[quote_key]
          assign name = block.settings[name_key]
          assign title = block.settings[title_key]
          assign image = block.settings[image_key]
        %}

        <div class="ai-testimonial-scroll__card-{{ ai_gen_id }}">
          <div class="ai-testimonial-scroll__quote-{{ ai_gen_id }}">
            {% if quote != blank %}
              {{ quote }}
            {% else %}
              Add a testimonial quote here to showcase customer feedback and build trust with potential buyers.
            {% endif %}
          </div>

          <div class="ai-testimonial-scroll__author-{{ ai_gen_id }}">
            <div class="ai-testimonial-scroll__image-wrapper-{{ ai_gen_id }}">
              {% if image %}
                <img
                  src="{{ image | image_url: width: 200 }}"
                  alt="{{ name | escape }}"
                  loading="lazy"
                  width="200"
                  height="200"
                >
              {% else %}
                {{ 'image' | placeholder_svg_tag }}
              {% endif %}
            </div>

            <div class="ai-testimonial-scroll__author-info-{{ ai_gen_id }}">
              <p class="ai-testimonial-scroll__name-{{ ai_gen_id }}">
                {% if name != blank %}
                  {{ name }}
                {% else %}
                  Customer Name
                {% endif %}
              </p>
              {% if title != blank %}
                <p class="ai-testimonial-scroll__title-{{ ai_gen_id }}">{{ title }}</p>
              {% endif %}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</testimonial-scroll-{{ ai_gen_id }}>

<script>
  (function() {
    class TestimonialScroll{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.wrapper = this.querySelector('.ai-testimonial-scroll__wrapper-{{ ai_gen_id }}');
        this.setupScrollBehavior();
      }

      setupScrollBehavior() {
        if (!this.wrapper) return;

        let isDown = false;
        let startX;
        let scrollLeft;

        this.wrapper.addEventListener('mousedown', (e) => {
          isDown = true;
          this.wrapper.style.cursor = 'grabbing';
          startX = e.pageX - this.wrapper.offsetLeft;
          scrollLeft = this.wrapper.scrollLeft;
        });

        this.wrapper.addEventListener('mouseleave', () => {
          isDown = false;
          this.wrapper.style.cursor = 'grab';
        });

        this.wrapper.addEventListener('mouseup', () => {
          isDown = false;
          this.wrapper.style.cursor = 'grab';
        });

        this.wrapper.addEventListener('mousemove', (e) => {
          if (!isDown) return;
          e.preventDefault();
          const x = e.pageX - this.wrapper.offsetLeft;
          const walk = (x - startX) * 2;
          this.wrapper.scrollLeft = scrollLeft - walk;
        });
      }
    }

    customElements.define('testimonial-scroll-{{ ai_gen_id }}', TestimonialScroll{{ ai_gen_id }});
  })();
</script>

