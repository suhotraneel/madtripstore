{%- style -%}
  #shopify-section-{{ section.id }} {
    position: relative;
    z-index: 1;
    {%- if section.settings.enable_top_clip -%}
       margin-top: calc((100vw * -56 / 2463) - {{ section.settings.vertical_offset | default: 0 }}px) !important;
    {%- endif -%}
  }

  .carousel-{{ section.id }} {
    --svg-cut-height-top: calc(100vw * 56 / 2463);
    --svg-cut-height-bottom: calc(100vw * 56 / 2463);

    width: 100%;
    display: block;
    position: relative;
    font-family: inherit;
    background-color: {{ section.settings.bg_color }};
    overflow: visible;
    z-index: 1;

    /* Dynamic Height: Fluid scaling based on Shopify Settings */
    {%- comment -%} Image Dimension Assignments {%- endcomment -%}
    {%- assign img_w360 = section.settings.img_w_360 -%}
    {%- assign img_w767 = section.settings.img_w_767 -%}
    {%- assign img_h768 = section.settings.img_h_768 -%}
    {%- assign img_h1400 = section.settings.img_h_1400 -%}

    {%- comment -%} Slope Calculations {%- endcomment -%}
    {%- assign h360 = section.settings.height_360 -%}
    {%- assign h767 = section.settings.height_767 -%}
    {%- assign h768 = section.settings.height_768 -%}
    {%- assign h1400 = section.settings.height_1400 -%}

    {%- assign slope_h_mobile = h767 | minus: h360 | times: 1.0 | divided_by: 407 -%}
    {%- assign slope_h_desktop = h1400 | minus: h768 | times: 1.0 | divided_by: 632 -%}

    {%- assign slope_img_w_mobile = img_w767 | minus: img_w360 | times: 1.0 | divided_by: 407 -%}
    {%- assign slope_img_h_desktop = img_h1400 | minus: img_h768 | times: 1.0 | divided_by: 632 -%}


    min-height: {{ h360 }}px;
    height: auto;
    display: flex;
    align-items: stretch;
    justify-content: center;
    padding: 0;

    @media screen and (min-width: 360px) {
      min-height: calc({{ h360 }}px + (100vw - 360px) * {{ slope_h_mobile }});
      height: auto;
    }
    @media screen and (min-width: 767px) {
      min-height: {{ h767 }}px;
      height: auto;
    }
    @media screen and (min-width: 768px) {
      min-height: calc({{ h768 }}px + (100vw - 768px) * {{ slope_h_desktop }});
      height: auto;
    }
    @media screen and (min-width: 1400px) {
      min-height: {{ h1400 }}px;
      height: auto;
    }

    {%- if section.settings.enable_top_clip or section.settings.enable_bottom_clip -%}
      {%- capture top_svg -%}<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 2463 56' preserveAspectRatio='none'><path fill='black' d='M2462.16 25.9036C2444.34 23.2552 2427.84 16.5352 2409.51 15.1517C2392.98 13.9262 2375.31 14.282 2359.39 18.8674C2350.35 21.4764 2340.3 28.1568 2331.63 29.6589C2294.54 36.1022 2257.89 0.328134 2214.87 4.24154C2182.92 7.16672 2154.72 32.7027 2125.39 36.4185C2094.72 40.2923 2068.23 17.1281 2036.25 17.1281C1991.29 17.1281 1978.76 48.0796 1927.03 30.2123C1893.44 18.6302 1874.9 0.209546 1835.63 4.24154C1808.34 7.0086 1781.49 28.2754 1754.28 30.1728C1733.84 31.5959 1718.21 17.7211 1698.5 15.3493C1641.13 8.43166 1615.41 33.6909 1567.17 40.4109C1533.66 45.1149 1501.85 22.346 1472.49 23.6505C1450.96 24.5992 1417.7 47.7634 1392.45 51.2024C1338.72 58.5154 1322.91 37.4858 1278.75 20.5276C1247.2 8.43166 1225.6 28.0382 1194.16 32.0702C1180.43 33.8491 1158.93 33.7305 1145.27 31.7935C1120.28 28.2359 1089.93 9.49896 1066.36 18.3535C1023.63 34.4420 1013.03 55.9064 960.023 51.7954C918.165 48.5540 889.057 17.8001 845.887 26.8524C801.406 36.1813 795.431 46.8542 746.651 33.4142C706.213 22.2669 681.44 9.89425 636.704 15.3098C622.605 17.0095 610.219 26.0618 597.505 28.7893C564.426 35.865 530.072 7.32483 497.576 4.24154C451.31 -0.146219 438.377 20.8439 400.271 32.426C357.174 45.5497 331.891 15.626 288.903 17.1677C259.431 18.2349 236.99 38.3554 209.522 36.7347C173.273 34.6001 140.814 3.84625 100.74 3.01614C64.6744 2.26508 35.7851 28.3545 0.15625 30.2123 L 0 56 L 2463 56 Z'/></svg>{%- endcapture -%}
      {%- capture bottom_svg -%}<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 2463 56' preserveAspectRatio='none'><path fill='black' d='M2462.16 25.9036C2444.34 23.2552 2427.84 16.5352 2409.51 15.1517C2392.98 13.9262 2375.31 14.282 2359.39 18.8674C2350.35 21.4764 2340.3 28.1568 2331.63 29.6589C2294.54 36.1022 2257.89 0.328134 2214.87 4.24154C2182.92 7.16672 2154.72 32.7027 2125.39 36.4185C2094.72 40.2923 2068.23 17.1281 2036.25 17.1281C1991.29 17.1281 1978.76 48.0796 1927.03 30.2123C1893.44 18.6302 1874.9 0.209546 1835.63 4.24154C1808.34 7.0086 1781.49 28.2754 1754.28 30.1728C1733.84 31.5959 1718.21 17.7211 1698.5 15.3493C1641.13 8.43166 1615.41 33.6909 1567.17 40.4109C1533.66 45.1149 1501.85 22.346 1472.49 23.6505C1450.96 24.5992 1417.7 47.7634 1392.45 51.2024C1338.72 58.5154 1322.91 37.4858 1278.75 20.5276C1247.2 8.43166 1225.6 28.0382 1194.16 32.0702C1180.43 33.8491 1158.93 33.7305 1145.27 31.7935C1120.28 28.2359 1089.93 9.49896 1066.36 18.3535C1023.63 34.4420 1013.03 55.9064 960.023 51.7954C918.165 48.5540 889.057 17.8001 845.887 26.8524C801.406 36.1813 795.431 46.8542 746.651 33.4142C706.213 22.2669 681.44 9.89425 636.704 15.3098C622.605 17.0095 610.219 26.0618 597.505 28.7893C564.426 35.865 530.072 7.32483 497.576 4.24154C451.31 -0.146219 438.377 20.8439 400.271 32.426C357.174 45.5497 331.891 15.626 288.903 17.1677C259.431 18.2349 236.99 38.3554 209.522 36.7347C173.273 34.6001 140.814 3.84625 100.74 3.01614C64.6744 2.26508 35.7851 28.3545 0.15625 30.2123 L 0 0 L 2463 0 Z'/></svg>{%- endcapture -%}
      {%- capture stroke_svg -%}<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 2463 56' preserveAspectRatio='none'><path fill='none' stroke='black' stroke-width='6' d='M2462.16 25.9036C2444.34 23.2552 2427.84 16.5352 2409.51 15.1517C2392.98 13.9262 2375.31 14.282 2359.39 18.8674C2350.35 21.4764 2340.3 28.1568 2331.63 29.6589C2294.54 36.1022 2257.89 0.328134 2214.87 4.24154C2182.92 7.16672 2154.72 32.7027 2125.39 36.4185C2094.72 40.2923 2068.23 17.1281 2036.25 17.1281C1991.29 17.1281 1978.76 48.0796 1927.03 30.2123C1893.44 18.6302 1874.9 0.209546 1835.63 4.24154C1808.34 7.0086 1781.49 28.2754 1754.28 30.1728C1733.84 31.5959 1718.21 17.7211 1698.5 15.3493C1641.13 8.43166 1615.41 33.6909 1567.17 40.4109C1533.66 45.1149 1501.85 22.346 1472.49 23.6505C1450.96 24.5992 1417.7 47.7634 1392.45 51.2024C1338.72 58.5154 1322.91 37.4858 1278.75 20.5276C1247.2 8.43166 1225.6 28.0382 1194.16 32.0702C1180.43 33.8491 1158.93 33.7305 1145.27 31.7935C1120.28 28.2359 1089.93 9.49896 1066.36 18.3535C1023.63 34.442 1013.03 55.9064 960.023 51.7954C918.165 48.554 889.057 17.8001 845.887 26.8524C801.406 36.1813 795.431 46.8542 746.651 33.4142C706.213 22.2669 681.44 9.89425 636.704 15.3098C622.605 17.0095 610.219 26.0618 597.505 28.7893C564.426 35.865 530.072 7.32483 497.576 4.24154C451.31 -0.146219 438.377 20.8439 400.271 32.426C357.174 45.5497 331.891 15.626 288.903 17.1677C259.431 18.2349 236.99 38.3554 209.522 36.7347C173.273 34.6001 140.814 3.84625 100.74 3.01614C64.6744 2.26508 35.7851 28.3545 0.15625 30.2123'/></svg>{%- endcapture -%}

      -webkit-mask-image: 
        {% if section.settings.enable_top_clip %}url("data:image/svg+xml;utf8,{{ top_svg }}"),{% endif %}
        {% if section.settings.enable_bottom_clip %}url("data:image/svg+xml;utf8,{{ bottom_svg }}"),{% endif %}
        linear-gradient(black, black);
      -webkit-mask-size: 
        {% if section.settings.enable_top_clip %}100% var(--svg-cut-height-top),{% endif %}
        {% if section.settings.enable_bottom_clip %}100% var(--svg-cut-height-bottom),{% endif %}
        100% calc(100% - {% if section.settings.enable_top_clip %}var(--svg-cut-height-top){% else %}0px{% endif %} - {% if section.settings.enable_bottom_clip %}var(--svg-cut-height-bottom){% else %}0px{% endif %} + 2px);
      -webkit-mask-position: 
        {% if section.settings.enable_top_clip %}top center,{% endif %}
        {% if section.settings.enable_bottom_clip %}bottom center,{% endif %}
        0 {% if section.settings.enable_top_clip %}calc(var(--svg-cut-height-top) - 1px){% else %}0px{% endif %};
      -webkit-mask-repeat: no-repeat;
      
      mask-image: 
        {% if section.settings.enable_top_clip %}url("data:image/svg+xml;utf8,{{ top_svg }}"),{% endif %}
        {% if section.settings.enable_bottom_clip %}url("data:image/svg+xml;utf8,{{ bottom_svg }}"),{% endif %}
        linear-gradient(black, black);
      mask-size: 
        {% if section.settings.enable_top_clip %}100% var(--svg-cut-height-top),{% endif %}
        {% if section.settings.enable_bottom_clip %}100% var(--svg-cut-height-bottom),{% endif %}
        100% calc(100% - {% if section.settings.enable_top_clip %}var(--svg-cut-height-top){% else %}0px{% endif %} - {% if section.settings.enable_bottom_clip %}var(--svg-cut-height-bottom){% else %}0px{% endif %} + 2px);
      mask-position: 
        {% if section.settings.enable_top_clip %}top center,{% endif %}
        {% if section.settings.enable_bottom_clip %}bottom center,{% endif %}
        0 {% if section.settings.enable_top_clip %}calc(var(--svg-cut-height-top) - 1px){% else %}0px{% endif %};
      mask-repeat: no-repeat;
    {%- endif -%}
  }

  .carousel-{{ section.id }}::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      width: 100%;
      height: var(--svg-cut-height-bottom);
      display: {% if section.settings.enable_bottom_clip %}block{% else %}none{% endif %};
      pointer-events: none;
      z-index: 5;
      background-image: url("data:image/svg+xml;utf8,{{ stroke_svg }}");
      background-size: 100% var(--svg-cut-height-bottom);
      background-position: bottom center;
      background-repeat: no-repeat;
  }

  .carousel-{{ section.id }} .carousel-container {
    display: flex;
    flex-direction: column-reverse;
    justify-content: space-between; /* Image at top, Text neatly below */
    align-items: center;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px calc(var(--svg-cut-height-bottom, 0px) + {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px) 20px;
    gap: 8px;
    flex: 1;
    min-height: 0;
    width: 100%;
    box-sizing: border-box;
    position: relative;
  }

  @media (min-width: 768px) {
    .carousel-{{ section.id }} .carousel-container {
      flex-direction: row-reverse;
      align-items: center; /* Center horizontally and vertically align columns */
      justify-content: space-between;
      padding: 0 96px calc(var(--svg-cut-height-bottom, 0px) + {{ section.settings.padding_bottom | default: 64 }}px) 96px;
      gap: 48px;
    }
  }

  .carousel-{{ section.id }} .carousel-wrapper {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    z-index: 2;
  }

  .carousel-{{ section.id }} .testimonials-title-wrapper {
    padding-top: calc(var(--svg-cut-height-top, 0px) + {{ section.settings.padding_top | times: 0.75 | round: 0 }}px);
    text-align: center;
    width: 100%;
    box-sizing: border-box;
    margin-bottom: 2rem;
  }
  
  .carousel-{{ section.id }} .testimonials-title {
    margin: 0;
    text-align: center !important;
    font-size: 40px !important;
    line-height: 1.2 !important;
    width: 100% !important;
    color: {{ section.settings.quote_color }};
  }

  @media (min-width: 768px) {
    .carousel-{{ section.id }} .testimonials-title-wrapper {
      padding-top: calc(var(--svg-cut-height-top, 0px) + {{ section.settings.padding_top | default: 64 }}px);
      padding-left: 50px;
      padding-right: 50px;
      max-width: 1400px;
      margin: 0 auto;
      margin-bottom: 3rem;
    }
    .carousel-{{ section.id }} .testimonials-title {
      font-size: 64px !important;
    }
  }

  /* ===== LEFT SIDE: TEXT ===== */
  .carousel-{{ section.id }} .carousel-left {
    width: 100%;
    max-width: 480px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;       /* Mobile: center horizontally */
    justify-content: flex-end; /* Mobile: bottom align */
    text-align: center;
    gap: 32px;
    z-index: 2;
    box-sizing: border-box;
  }

  @media (min-width: 768px) {
    .carousel-{{ section.id }} .carousel-left {
      flex: 1;
      min-width: 0; /* Prevents overflow in flexbox */
      max-width: none;
      margin: 0;
      height: 100%;
      align-items: flex-start; /* Desktop: left */
      justify-content: space-between; /* Desktop: span full vertical space */
      text-align: left;
    }
  }

  .carousel-{{ section.id }} .carousel-text {
    color: inherit;
    line-height: normal;
    display: flex;
    flex-direction: column;
    gap: 20px;
    width: 100%;
  }

  @media (min-width: 768px) {
    .carousel-{{ section.id }} .carousel-text {
      gap: 24px;
      flex-grow: 1;
    }
  }

  .carousel-{{ section.id }} .carousel-quote {
    font-size: 16px;
    font-weight: 700;
    max-width: 100%;
    margin: 0;
    color: {{ section.settings.quote_color }};
  }

  @media (min-width: 768px) {
    .carousel-{{ section.id }} .carousel-quote {
      font-size: calc(16px + (100vw - 768px) * 8 / 632);
      flex-grow: 1;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
    }
  }

  @media (min-width: 1400px) {
    .carousel-{{ section.id }} .carousel-quote {
      font-size: 24px;
    }
  }

  .carousel-{{ section.id }} .carousel-author {
    font-size: 12.8px;
    font-weight: 400;
    margin: 0;
    color: {{ section.settings.author_color }};
  }

  @media (min-width: 768px) {
    .carousel-{{ section.id }} .carousel-author {
      font-size: calc(0.8 * (16px + (100vw - 768px) * 8 / 632));
      margin-top: auto;
    }
  }

  @media (min-width: 1400px) {
    .carousel-{{ section.id }} .carousel-author {
      font-size: 19.2px;
    }
  }

  .carousel-{{ section.id }} .fade-slide {
    opacity: 0;
    transition: opacity 0.1s ease;
  }

  .carousel-{{ section.id }} .fade-slide.show {
    opacity: 1;
    transition: opacity 1s ease;
  }

  /* ===== CONTROLS ===== */
  .carousel-{{ section.id }} .nav-btn {
    background: transparent;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center; 
    padding: 10px;
  }

  .carousel-{{ section.id }} .nav-btn .chevron-icon {
    width: 24px;
    height: 24px;
    display: block;
    background-color: #000000;
    -webkit-mask-size: contain;
    mask-size: contain;
    -webkit-mask-position: center;
    mask-position: center;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    transition: opacity 0.2s ease;
  }
  
  @media (min-width: 768px) {
    .carousel-{{ section.id }} .nav-btn .chevron-icon {
      width: 32px;
      height: 32px;
    }
  }
  
  .carousel-{{ section.id }} .nav-btn .chevron-left {
    -webkit-mask-image: url("https://cdn.shopify.com/s/files/1/0655/0667/2825/files/chevron_left.svg?v=1769011900");
    mask-image: url("https://cdn.shopify.com/s/files/1/0655/0667/2825/files/chevron_left.svg?v=1769011900");
  }
  
  .carousel-{{ section.id }} .nav-btn .chevron-right {
    -webkit-mask-image: url("https://cdn.shopify.com/s/files/1/0655/0667/2825/files/chevron_right.svg?v=1769011900");
    mask-image: url("https://cdn.shopify.com/s/files/1/0655/0667/2825/files/chevron_right.svg?v=1769011900");
  }

  @media (hover: hover) and (pointer: fine) {
    .carousel-{{ section.id }} .nav-btn:hover .chevron-icon {
      opacity: 0.7;
    }
  }

  .carousel-{{ section.id }} .nav-btn:active .chevron-icon {
    opacity: 0.5;
  }

  .carousel-{{ section.id }} .desktop-only { display: none !important; }
  .carousel-{{ section.id }} .mobile-only { display: flex !important; }

  @media (min-width: 768px) {
    .carousel-{{ section.id }} .desktop-only { display: flex !important; }
    .carousel-{{ section.id }} .mobile-only { display: none !important; }

    .carousel-{{ section.id }} .nav-btn.desktop-only {
      position: absolute;
      top: 42%;
      transform: translateY(-50%);
      z-index: 10;
    }
    .carousel-{{ section.id }} .nav-btn.prev-btn.desktop-only { left: 24px; }
    .carousel-{{ section.id }} .nav-btn.next-btn.desktop-only { right: 24px; }
  }

  .carousel-{{ section.id }} .mobile-image-wrapper {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    gap: 16px;
  }

  @media (min-width: 768px) {
    .carousel-{{ section.id }} .mobile-image-wrapper {
      width: auto;
      justify-content: center;
    }
  }

  @media (max-width: 767px) {
    .carousel-{{ section.id }} .nav-btn.mobile-only {
      flex-shrink: 0;
    }
    .carousel-{{ section.id }} .carousel-right {
      max-width: calc(100vw - 112px);
      flex-shrink: 1;
    }
  }

  /* ===== RIGHT SIDE: IMAGE ===== */
  .carousel-{{ section.id }} .carousel-right {
    margin: 0 auto;
    aspect-ratio: {{ section.settings.image_aspect_ratio | default: '1/1' }};
    width: {{ img_w360 }}px;
    height: auto;
    
    @media (min-width: 360px) {
      width: calc({{ img_w360 }}px + (100vw - 360px) * {{ slope_img_w_mobile }});
    }

    @media (min-width: 767px) {
      width: {{ img_w767 }}px;
    }

    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;

    {%- if section.settings.svg_code != blank -%}
      /* Use inline SVG code if provided by using base64 data URI trick or inline SVG wrap */
      {%- assign svg_data = section.settings.svg_code | replace: '"', "'" | replace: '<svg', '<svg xmlns="http://www.w3.org/2000/svg"' | strip_newlines -%}
      -webkit-mask-image: url("data:image/svg+xml,{{ svg_data | url_encode }}");
      mask-image: url("data:image/svg+xml,{{ svg_data | url_encode }}");
      -webkit-mask-size: contain;
      mask-size: contain;
      -webkit-mask-repeat: no-repeat;
      mask-repeat: no-repeat;
      -webkit-mask-position: center;
      mask-position: center;
    {%- elsif section.settings.svg_mask != blank -%}
      /* Fallback to Image Picker */
      -webkit-mask-image: url('{{ section.settings.svg_mask | image_url }}');
      mask-image: url('{{ section.settings.svg_mask | image_url }}');
      -webkit-mask-size: contain;
      mask-size: contain;
      -webkit-mask-repeat: no-repeat;
      mask-repeat: no-repeat;
      -webkit-mask-position: center;
      mask-position: center;
    {%- endif -%}
  }

  @media (min-width: 768px) {
    .carousel-{{ section.id }} .carousel-right {
      margin: 0;
      height: calc({{ img_h768 }}px + (100vw - 768px) * {{ slope_img_h_desktop }});
      width: auto;
      min-height: unset;
    }
  }

  @media (min-width: 1400px) {
    .carousel-{{ section.id }} .carousel-right {
      height: {{ img_h1400 }}px;
    }
  }

  .carousel-{{ section.id }} .carousel-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 1s ease;
  }
  
  /* Additional helper to prevent broken image icons when there's no img src initially */
  .carousel-{{ section.id }} img.carousel-bg { color: transparent; }
  
  /* Required for custom element to behave like block */
  testimonial-carousel.carousel-{{ section.id }} {
    display: block;
  }
{%- endstyle -%}

<testimonial-carousel class="carousel carousel-{{ section.id }}" data-autoplay="{{ section.settings.autoplay }}" data-delay="{{ section.settings.autoplay_delay | times: 1000 }}" data-section-id="{{ section.id }}">
  <div class="carousel-wrapper">
    {%- if section.settings.title != blank -%}
      <div class="testimonials-title-wrapper page-width{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        <h2 class="testimonials-title inline-richtext{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          {{ section.settings.title }}
        </h2>
      </div>
    {%- endif -%}
    <div class="carousel-container">
    
      <button class="nav-btn prev-btn desktop-only prev-btn-{{ section.id }}" aria-label="Previous slide">
        <div class="chevron-icon chevron-left"></div>
      </button>

      <!-- LEFT SIDE: Text -->
      <div class="carousel-left">
        <div class="carousel-text">
          <p id="quote-{{ section.id }}" class="carousel-quote fade-slide show"></p>
          <p id="author-{{ section.id }}" class="carousel-author fade-slide show"></p>
        </div>
      </div>

      <!-- RIGHT SIDE: Masked Image -->
      <div class="mobile-image-wrapper">
        <button class="nav-btn prev-btn mobile-only prev-btn-{{ section.id }}" aria-label="Previous slide">
          <div class="chevron-icon chevron-left"></div>
        </button>

        <div class="carousel-right">
          <img id="bg1-{{ section.id }}" class="carousel-bg" src="" alt="" />
          <img id="bg2-{{ section.id }}" class="carousel-bg" src="" alt="" style="opacity: 0;" />
        </div>

        <button class="nav-btn next-btn mobile-only next-btn-{{ section.id }}" aria-label="Next slide">
          <div class="chevron-icon chevron-right"></div>
        </button>
      </div>

      <button class="nav-btn next-btn desktop-only next-btn-{{ section.id }}" aria-label="Next slide">
        <div class="chevron-icon chevron-right"></div>
      </button>

    </div>

  <script type="application/json" id="slidesData-{{ section.id }}">
    [
      {% for block in section.blocks %}
        {
          "quote": {{ block.settings.quote | json }},
          "author": {{ block.settings.author | json }},
          "img": {% if block.settings.image %}{{ block.settings.image | image_url: width: 1400 | json }}{% else %}"https://images.unsplash.com/photo-1529626455594-4ff0802cfb7e?auto=format&fit=crop&w=1200&q=80"{% endif %}
        }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ]
  </script>
</testimonial-carousel>

{%- unless custom_element_defined -%}
<script>
  if (!customElements.get('testimonial-carousel')) {
    class TestimonialCarousel extends HTMLElement {
      constructor() {
        super();
        this.sectionId = this.dataset.sectionId;
        this.isAutoplay = this.dataset.autoplay === 'true';
        this.autoPlayDelay = parseInt(this.dataset.delay, 10) || 4000;
        
        this.bg1 = this.querySelector(`#bg1-${this.sectionId}`);
        this.bg2 = this.querySelector(`#bg2-${this.sectionId}`);
        this.activeBg = 1;

        this.quote = this.querySelector(`#quote-${this.sectionId}`);
        this.author = this.querySelector(`#author-${this.sectionId}`);
        this.prevBtns = this.querySelectorAll(`.prev-btn-${this.sectionId}`);
        this.nextBtns = this.querySelectorAll(`.next-btn-${this.sectionId}`);

        this.index = 0;
        this.autoPlayTimer = null;
        
        try {
          const slidesData = this.querySelector(`#slidesData-${this.sectionId}`).textContent;
          this.slides = JSON.parse(slidesData);
        } catch (e) {
          this.slides = [];
        }
      }

      connectedCallback() {
        if (this.slides.length === 0) return;
        this.render();
        if (this.isAutoplay) this.startAutoPlay();

        if (this.nextBtns.length > 0) {
          this.nextBtns.forEach(btn => {
            btn.addEventListener('click', () => {
              this.stopAutoPlay();
              this.index = (this.index + 1) % this.slides.length;
              this.render();
              if (this.isAutoplay) this.startAutoPlay();
            });
          });
        }

        if (this.prevBtns.length > 0) {
          this.prevBtns.forEach(btn => {
            btn.addEventListener('click', () => {
              this.stopAutoPlay();
              this.index = (this.index - 1 + this.slides.length) % this.slides.length;
              this.render();
              if (this.isAutoplay) this.startAutoPlay();
            });
          });
        }
      }

      disconnectedCallback() {
        this.stopAutoPlay();
      }

      render() {
        if (this.slides.length === 0) return;
        const slide = this.slides[this.index];

        // Background crossfade
        if (this.activeBg === 1) {
          if (this.bg2) {
            this.bg2.src = slide.img || '';
            this.bg2.style.opacity = "1";
          }
          if (this.bg1) this.bg1.style.opacity = "0";
          this.activeBg = 2;
        } else {
          if (this.bg1) {
            this.bg1.src = slide.img || '';
            this.bg1.style.opacity = "1";
          }
          if (this.bg2) this.bg2.style.opacity = "0";
          this.activeBg = 1;
        }

        // Text animation (fade out)
        if (this.quote) this.quote.classList.remove("show");
        if (this.author) this.author.classList.remove("show");

        setTimeout(() => {
          if (this.quote) {
            this.quote.textContent = slide.quote;
            this.quote.classList.add("show");
          }
          if (this.author) {
            this.author.textContent = slide.author;
            this.author.classList.add("show");
          }
        }, 100);
      }

      startAutoPlay() {
        this.stopAutoPlay();
        this.autoPlayTimer = setInterval(() => {
          this.index = (this.index + 1) % this.slides.length;
          this.render();
        }, this.autoPlayDelay);
      }

      stopAutoPlay() {
        if (this.autoPlayTimer) {
          clearInterval(this.autoPlayTimer);
          this.autoPlayTimer = null;
        }
      }
    }

    customElements.define('testimonial-carousel', TestimonialCarousel);
  }
</script>
{%- assign custom_element_defined = true -%}
{%- endunless -%}

