{% schema %}
{
  "name": "Global Fly",
  "settings": [
    {
      "type": "image_picker",
      "id": "fly_image_1",
      "label": "Fly Animation Frame 1"
    },
    {
      "type": "image_picker",
      "id": "fly_image_2",
      "label": "Fly Animation Frame 2"
    },
    {
      "type": "image_picker",
      "id": "fly_image_3",
      "label": "Fly Animation Frame 3"
    }
  ],
  "presets": [
    {
      "name": "Global Fly"
    }
  ]
}
{% endschema %}

<style>
  .global-fly {
    position: fixed;
    z-index: 99; /* Stay on top of content but below the preloader and major modals/drawers */
    transition: left 0.3s ease-in-out, top 0.3s ease-in-out;
    transform: translateX(-50%) translateY(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    pointer-events: auto;
  }

  .global-fly-img {
    width: 48px;
    height: 48px;
    padding: 15px; /* Increases touch target size */
    margin: -15px; /* Offsets padding to keep layout unchanged */
    box-sizing: content-box;
    object-fit: cover;
    -webkit-tap-highlight-color: transparent;
    cursor: pointer;
  }

  .global-fly-text {
    font-family: "PallyVariable", sans-serif;
    font-size: 14px;
    line-height: 20px;
    color: #111111;
    background-color: #ffde17;
    padding: 4px 10px;
    border-radius: 14px 14px 14px 0px;
    border: 0.5px solid #111111;
    white-space: nowrap;
    position: absolute;
    bottom: 100%;
    left: 50%;
    margin-bottom: -5px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease-in-out;
  }

  .global-fly-text.is-visible {
    opacity: 1;
  }

  .global-fly-text--right {
    left: auto;
    right: 50%;
    border-radius: 14px 14px 0px 14px;
  }

  @media (min-width: 768px) {
    .global-fly-img {
      width: 64px;
      height: 64px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const flyWrap = document.createElement('div');
    flyWrap.className = 'global-fly';

    const flyText = document.createElement('div');
    flyText.className = 'global-fly-text';
    flyText.innerText = 'nahi jayega';
    flyWrap.appendChild(flyText);

    const flyImg = document.createElement('img');
    flyImg.className = 'global-fly-img';
    
    // We now use section.settings instead of global settings
    {% if section.settings.fly_image_1 != blank %}
    const flySrc1 = '{{ section.settings.fly_image_1 | image_url: width: 128 }}';
    {% else %}
    const flySrc1 = 'https://via.placeholder.com/64x64?text=Fly1';
    {% endif %}
    
    {% if section.settings.fly_image_2 != blank %}
    const flySrc2 = '{{ section.settings.fly_image_2 | image_url: width: 128 }}';
    {% else %}
    const flySrc2 = 'https://via.placeholder.com/64x64?text=Fly2';
    {% endif %}

    {% if section.settings.fly_image_3 != blank %}
    const flySrc3 = '{{ section.settings.fly_image_3 | image_url: width: 128 }}';
    {% else %}
    const flySrc3 = 'https://via.placeholder.com/64x64?text=Fly3';
    {% endif %}
    
    flyImg.src = flySrc1;
    flyImg.alt = 'Fly Animation';
    flyWrap.appendChild(flyImg);
    
    let currentFrame = 0;
    const frames = [flySrc1, flySrc2, flySrc3];
    setInterval(() => {
      currentFrame = (currentFrame + 1) % frames.length;
      flyImg.src = frames[currentFrame];
    }, 200);
    
    let activeTextTimer = null;
    const showText = () => {
      if (activeTextTimer) clearTimeout(activeTextTimer);
      
      flyText.classList.add('is-visible');
      
      activeTextTimer = setTimeout(() => {
        flyText.classList.remove('is-visible');
      }, 1000);
    };

    const randomizePosition = () => {
      const screenWidth = window.innerWidth;
      const screenHeight = window.innerHeight;
      const safeMargin = 40;

      // Keep within the left or right 15% of the screen width, up to a max of 150px
      const sideWidth = Math.min(screenWidth * 0.15, 150);

      const currentLeft = parseFloat(flyWrap.style.left) || 0;
      const currentTop = parseFloat(flyWrap.style.top) || 0;

      let isMovingToRight;

      if (!currentLeft) {
        // Initial load: pick a completely random side
        isMovingToRight = Math.random() > 0.5;
      } else {
        // Always jump to the opposite horizontal side to get far away from current position
        isMovingToRight = currentLeft < screenWidth / 2;
      }

      let newLeft;
      if (isMovingToRight) {
        const minLeft = screenWidth - sideWidth - safeMargin;
        const maxLeft = screenWidth - safeMargin;
        newLeft = minLeft + Math.random() * (maxLeft - minLeft);
      } else {
        const minLeft = safeMargin;
        const maxLeft = safeMargin + sideWidth;
        newLeft = minLeft + Math.random() * (maxLeft - minLeft);
      }

      // Randomize vertical placement, ensuring it also moves at least 30% away from current altitude
      let newTop;
      let topAttempts = 0;
      const minDistanceY = screenHeight * 0.3;
      do {
        newTop = safeMargin + Math.random() * (screenHeight - 2 * safeMargin);
        topAttempts++;
      } while (currentTop > 0 && Math.abs(newTop - currentTop) < minDistanceY && topAttempts < 20);

      flyWrap.style.left = newLeft + 'px';
      flyWrap.style.top = newTop + 'px';

      if (newLeft > screenWidth / 2) {
        flyText.classList.add('global-fly-text--right');
      } else {
        flyText.classList.remove('global-fly-text--right');
      }
    };

    const moveFly = (e) => {
      if (e && e.type === 'touchstart') {
        e.preventDefault(); 
      }
      
      flyText.classList.remove('is-visible');
      if (activeTextTimer) clearTimeout(activeTextTimer);
      
      randomizePosition();
      showText();
    };

    flyWrap.addEventListener('mouseenter', moveFly);
    flyWrap.addEventListener('touchstart', moveFly, { passive: false });
    flyWrap.addEventListener('click', showText);
    
    document.body.appendChild(flyWrap);

    randomizePosition();

    let resizeTimer;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        randomizePosition();
      }, 200);
    });
  });
</script>
