{% schema %}
{
  "name": "Madtrip Footer",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#111111"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo Image"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 50,
      "max": 400,
      "step": 5,
      "unit": "px",
      "label": "Logo Width",
      "default": 280
    },
    {
      "type": "link_list",
      "id": "menu_below_logo",
      "label": "Menu Below Logo"
    },
    {
      "type": "html",
      "id": "accordion_icon",
      "label": "Accordion Arrow Icon (SVG)",
      "info": "Paste SVG code here. Leave blank to use default."
    },
    {
      "type": "image_picker",
      "id": "fly_image_1",
      "label": "Fly Animation Frame 1 (SVG/Image)"
    },
    {
      "type": "image_picker",
      "id": "fly_image_2",
      "label": "Fly Animation Frame 2 (SVG/Image)"
    },
    {
      "type": "link_list",
      "id": "menu_products",
      "label": "Products Menu"
    },
    {
      "type": "link_list",
      "id": "menu_support",
      "label": "Support Menu"
    },
    {
      "type": "link_list",
      "id": "menu_about",
      "label": "About Menu"
    },
    {
      "type": "text",
      "id": "copyright",
      "label": "Copyright Text",
      "default": "©2025 Madtrip, All rights reserved."
    },
    {
      "type": "header",
      "content": "Social Media Links"
    },
    {
      "type": "url",
      "id": "social_facebook",
      "label": "Facebook"
    },
    {
      "type": "url",
      "id": "social_instagram",
      "label": "Instagram"
    },
    {
      "type": "url",
      "id": "social_twitter",
      "label": "Twitter"
    },
    {
      "type": "url",
      "id": "social_pinterest",
      "label": "Pinterest"
    }
  ],
  "presets": [
    {
      "name": "Madtrip Footer"
    }
  ]
}
{% endschema %}

<style>
  @font-face {
    font-family: "Krugat";
    src: url("https://cdn.shopify.com/s/files/1/0655/0667/2825/files/Krugat.ttf?v=1761338417") format("truetype");
    font-weight: normal;
    font-style: normal;
    font-display: swap;
  }
  
  @font-face {
    font-family: "PallyVariable";
    src: url("https://cdn.shopify.com/s/files/1/0655/0667/2825/files/PallyVariable.ttf?v=1732101857") format("truetype");
    font-weight: normal;
    font-style: normal;
    font-display: swap;
  }
  
  /* Fallback for Pally if not available, using system sans-serif which is cleaner */
  
  .footer-madtrip {
    position: relative;
    background-color: {{ section.settings.bg_color }};
    color: #eaeaea;
    overflow: hidden;
    width: 100%;
    font-family: "PallyVariable";
  }

  .footer-madtrip__container {
    width: 100%;
    max-width: 1400px; /* From desktop design node */
    margin: 0 auto;
    padding: 48px 24px 24px; /* Mobile padding base */
    display: flex;
    flex-direction: column;
    gap: 84px;
  }

  /* TOP SECTION */
  .footer-madtrip__top {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 48px;
    width: 100%;
  }
  
  .footer-madtrip__brand-col {
    display: flex;
    flex-direction: column;
    align-items: center; /* Center on mobile */
    gap: 40px;
    max-width: 100%;
    width: 100%;
    text-align: center; /* Center text on mobile */
  }

  .footer-madtrip__logo-link {
    display: block;
    width: 100%;
    max-width: {{ section.settings.logo_width }}px;
    margin: 0 auto;
  }

  .footer-madtrip__logo {
    display: block;
    width: 100%;
    height: auto;
  }
  
  .footer-madtrip__logo-placeholder {
    font-size: 24px;
    font-weight: bold;
    color: #ffd700;
    letter-spacing: 1px;
    padding: 10px 0;
  }

  .footer-madtrip__logo-menu {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between !important;
    gap: 64px;
    list-style: none;
    padding: 0;
    margin: 0 auto;
    width: 100%;
    max-width: {{ section.settings.logo_width }}px;
  }

  .footer-madtrip__logo-menu.footer-madtrip__logo-menu--center {
    justify-content: center !important;
  }

  .footer-madtrip__logo-menu-link {
    font-family: "Krugat", sans-serif !important;
    font-weight: normal;
    font-size: 16px;
    color: #eaeaea;
    text-decoration: none;
    transition: color 0.2s ease, transform 0.2s ease;
    display: inline-block;
  }
  
  .footer-madtrip__logo-menu-link:hover {
    color: #ffffff;
    transform: scale(1.1);
  }

  .footer-madtrip__nav-row {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    width: 100%;
    max-width: 100%;
  }

  .footer-madtrip__menu-col {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .footer-madtrip__menu-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 0;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .footer-madtrip__menu-title {
    font-family: 'Krugat';
    font-size: 20px;
    font-weight: 400;
    color: #ffffff;
    margin: 0;
  }

  .footer-madtrip__menu-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    color: #ffffff;
  }

  .footer-madtrip__accordion-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    transition: transform 0.3s ease;
  }
  
  .footer-madtrip__accordion-icon svg {
    width: 100%;
    height: 100%;
  }

  .footer-madtrip__menu-col.is-active .footer-madtrip__accordion-icon {
    transform: rotate(180deg);
  }

  .footer-madtrip__menu-content {
    display: grid;
    grid-template-rows: 0fr;
    padding-bottom: 0;
    transition: grid-template-rows 0.3s ease-out, padding-bottom 0.3s ease-out;
  }

  .footer-madtrip__menu-content > * {
    overflow: hidden;
    min-height: 0;
  }

  .footer-madtrip__menu-col.is-active .footer-madtrip__menu-content {
    grid-template-rows: 1fr;
    padding-bottom: 16px;
  }

  .footer-madtrip__menu-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .footer-madtrip__menu-link {
    font-size: 14px;
    color: #eaeaea;
    text-decoration: none;
    display: inline-block; /* Required for transform scale to work properly */
    transform-origin: left center;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .footer-madtrip__menu-link:hover {
    color: #ffffff;
    text-decoration: none;
    transform: scale(1.2);
  }

  /* BOTTOM BAR */
  .footer-madtrip__bottom-bar {
    position: relative;
    width: 100%;
    border-radius: 1000px;
    padding: 20px 32px;
    background-color: #00ADEE;
    display: flex;
    flex-direction: column; /* Stacked on mobile */
    align-items: center;
    gap: 16px;
    text-align: center;
  }

  .footer-madtrip__copyright {
    font-size: 12px;
    color: #111111;
    line-height: 16px;
    margin: 0;
  }

  .footer-madtrip__social-list {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer-madtrip__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    color: #111111;
    transition: color 0.2s ease, transform 0.2s ease;
  }
  
  .footer-madtrip__social-link:hover {
    color: #000000;
    transform: scale(1.1);
  }
  
  .footer-madtrip__social-icon {
    width: 100%;
    height: 100%;
    object-fit: contain;
    fill: currentColor;
  }

  .footer-madtrip__fly {
    position: absolute;
    bottom: 100%;
    z-index: 10;
    transition: left 0.3s ease-in-out;
    transform: translateX(-50%) translateY(0);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .footer-madtrip__fly-img {
    width: 48px;
    height: 48px;
    padding: 15px; /* Invisibly increases the touch target size for mobile */
    margin-bottom: -15px; /* Offsets the bottom padding so visual placement is unchanged */
    box-sizing: content-box;
    object-fit: cover;
    -webkit-tap-highlight-color: transparent;
  }

  .footer-madtrip__fly-text {
    font-family: "PallyVariable";
    font-size: 14px;
    line-height: 20px;
    color: #111111;
    background-color: #ffd700;
    padding: 4px 10px;
    border-radius: 14px 14px 14px 0px;
    white-space: nowrap;
    position: absolute;
    bottom: 100%;
    left: 50%; /* Aligns the left edge of the text to the center of the fly */
    margin-bottom: -5px; /* Just above the fly */
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease-in-out;
  }

  .footer-madtrip__fly-text.is-visible {
    opacity: 1;
  }

  .footer-madtrip__fly-text--right {
    left: auto;
    right: 50%; /* Aligns the right edge of the text to the center of the fly */
    border-radius: 14px 14px 0px 14px;
  }

  /* RESPONSIVE: Tablet (>= 480px) */
  @media (min-width: 480px) {
    .footer-madtrip__container {
      padding: 48px 32px 32px;
      gap: 96px; /* Reduced gap */
    }

    .footer-madtrip__fly-img {
      width: 64px;
      height: 64px;
    }

    .footer-madtrip__nav-row {
      flex-direction: row;
      width: 100%;
      max-width: 560px;
      justify-content: space-between;
      gap: 24px; /* Minimum gap fallback */
    }
    
    .footer-madtrip__menu-col {
      width: auto;
      min-width: 0;
      align-items: flex-start;
      text-align: left;
    }

    .footer-madtrip__menu-header {
      padding: 0 0 16px 0;
      cursor: default;
    }

    .footer-madtrip__menu-icon {
      display: none;
    }

    .footer-madtrip__menu-content {
      display: block;
      padding-bottom: 0;
    }

    .footer-madtrip__menu-content > * {
      overflow: visible;
    }

    .footer-madtrip__menu-list {
      padding: 0;
    }

    .footer-madtrip__bottom-bar {
      flex-direction: row;
      justify-content: space-between;
      padding: 20px 24px;
    }
    
    .footer-madtrip__copyright {
      order: 1; /* Left */
    }
    
    .footer-madtrip__social-list {
      order: 2; /* Right */
    }
  }

  /* RESPONSIVE: Desktop (>= 1028px) */
  @media (min-width: 1028px) {
    .footer-madtrip__container {
      padding: 48px 50px 50px;
    }

    .footer-madtrip__top {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-start;
      gap: 64px;
    }

    .footer-madtrip__brand-col {
      align-items: flex-start;
      text-align: left;
      max-width: 400px; /* Accommodates up to 400px logo */
    }

    .footer-madtrip__logo-link {
      margin: 0;
    }

    .footer-madtrip__logo-menu {
      justify-content: space-between !important;
      text-align: left;
      margin: 0;
      width: 100%;
    }
    
    .footer-madtrip__logo-menu.footer-madtrip__logo-menu--center {
      justify-content: center !important;
    }

    .footer-madtrip__nav-row {
      width: auto;
      max-width: none;
      justify-content: flex-end;
      gap: 64px;
    }

    .footer-madtrip__bottom-bar {
      padding: 20px 24px;
    }
  }

  /* RESPONSIVE: Large Desktop (>= 1400px) */
  @media (min-width: 1400px) {
    .footer-madtrip__container {
        padding: 60px 50px 40px; /* Match desktop design padding */
    }
  }

</style>

<div class="footer-madtrip">
  <div class="footer-madtrip__container">
    
    <div class="footer-madtrip__top">
      <!-- Brand / Logo Section -->
      <div class="footer-madtrip__brand-col">
        {% if section.settings.logo != blank %}
          <a href="/" aria-label="Home" class="footer-madtrip__logo-link">
            {{ section.settings.logo | image_url: width: 800 | image_tag: class: 'footer-madtrip__logo', loading: 'lazy' }}
          </a>
        {% else %}
           <!-- Text Placeholder for Logo if no image -->
           <a href="/" aria-label="Home" class="footer-madtrip__logo-link" style="text-decoration: none; color: inherit;">
             <div class="footer-madtrip__logo-placeholder">MAD TRIP</div>
           </a>
        {% endif %}

        {% if section.settings.menu_below_logo != blank %}
          <ul class="footer-madtrip__logo-menu {% if linklists[section.settings.menu_below_logo].links.size == 1 %}footer-madtrip__logo-menu--center{% endif %}">
            {% for link in linklists[section.settings.menu_below_logo].links %}
              <li><a href="{{ link.url }}" class="footer-madtrip__logo-menu-link">{{ link.title }}</a></li>
            {% endfor %}
          </ul>
        {% endif %}
