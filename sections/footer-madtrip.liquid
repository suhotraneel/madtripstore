<script>
  document.addEventListener('DOMContentLoaded', function() {
    const bottomBar = document.querySelector('.footer-madtrip__bottom-bar');
    if (!bottomBar) return;

    function renderFlies() {
      // Remove existing flies to regenerate properly on window resize
      const existingFlies = bottomBar.querySelectorAll('.footer-madtrip__fly');
      existingFlies.forEach(fly => fly.remove());

      const barWidth = bottomBar.offsetWidth;
      // Always generate exactly 3 flies
      const numFlies = 3; 
      const placedPositions = [];
      const safeMargin = 40;
      const minDistance = 75; // Prevent overlap (flies are up to 64px max width + padding)

      let activeFlyText = null;
      let activeTextTimer = null;

      for (let i = 0; i < numFlies; i++) {
        let leftPosPx;
        let attempts = 0;
        let overlapping = true;

        // Try to find a non-overlapping position up to 50 times
        while (overlapping && attempts < 50) {
          leftPosPx = safeMargin + Math.random() * (barWidth - 2 * safeMargin);
          overlapping = placedPositions.some(pos => Math.abs(pos - leftPosPx) < minDistance);
          attempts++;
        }

        // If we couldn't find a free spot after 50 attempts, skip to avoid infinite loop
        if (overlapping) continue;

        placedPositions.push(leftPosPx);

        const flyWrap = document.createElement('div');
        flyWrap.className = 'footer-madtrip__fly';
        flyWrap.style.left = leftPosPx + 'px';

        const flyText = document.createElement('div');
        flyText.className = 'footer-madtrip__fly-text';
        if (leftPosPx > barWidth / 2) {
          flyText.classList.add('footer-madtrip__fly-text--right');
        }
        flyText.innerText = 'nahi jayega';
        flyWrap.appendChild(flyText);

        const flyImg = document.createElement('img');
        flyImg.className = 'footer-madtrip__fly-img';
        
        {% if section.settings.fly_image_1 != blank %}
        const flySrc1 = '{{ section.settings.fly_image_1 | image_url: width: 128 }}';
        {% else %}
        const flySrc1 = 'https://via.placeholder.com/64x64?text=Fly1';
        {% endif %}
        
        {% if section.settings.fly_image_2 != blank %}
        const flySrc2 = '{{ section.settings.fly_image_2 | image_url: width: 128 }}';
        {% else %}
        const flySrc2 = 'https://via.placeholder.com/64x64?text=Fly2';
        {% endif %}
        
        flyImg.src = flySrc1;
        flyImg.alt = 'Fly Animation';
        flyWrap.appendChild(flyImg);
        
        // Toggle src to create the buzzing animation natively
        let isFrame1 = true;
        setInterval(() => {
          isFrame1 = !isFrame1;
          flyImg.src = isFrame1 ? flySrc1 : flySrc2;
        }, 200); /* Fast fly speed toggle speed for wings */
        
        const showText = () => {
          if (activeFlyText && activeFlyText !== flyText) {
             activeFlyText.classList.remove('is-visible');
          }
          if (activeTextTimer) clearTimeout(activeTextTimer);
          
          flyText.classList.add('is-visible');
          activeFlyText = flyText;
          
          activeTextTimer = setTimeout(() => {
            flyText.classList.remove('is-visible');
            if (activeFlyText === flyText) activeFlyText = null;
          }, 1000);
        };

        const moveFly = (e) => {
          let isTouch = false;
          if (e && e.type === 'touchstart') {
            isTouch = true;
            // Prevent mouseenter from firing directly after touch
            e.preventDefault(); 
          }
          
          // Clear text ONLY if we touched/hovered a *different* fly
          if (activeFlyText && activeFlyText !== flyText) {
             activeFlyText.classList.remove('is-visible');
             activeFlyText = null;
             clearTimeout(activeTextTimer);
          }
          
          let newLeft;
          let moveAttempts = 0;
          let stillOverlapping = true;
          
          while (stillOverlapping && moveAttempts < 50) {
            newLeft = safeMargin + Math.random() * (barWidth - 2 * safeMargin);
            
            // Check potential overlap against all *currently rendered* flies
            const allFlies = Array.from(bottomBar.querySelectorAll('.footer-madtrip__fly'));
            stillOverlapping = allFlies.some(otherFly => {
              if (otherFly === flyWrap) return false; // Ignore self
              const otherLeftStyle = otherFly.style.left;
              if (!otherLeftStyle) return false;
              
              const otherLeft = parseFloat(otherLeftStyle);
              return Math.abs(otherLeft - newLeft) < minDistance;
            });
            moveAttempts++;
          }
          
          if (!stillOverlapping) {
             flyWrap.style.left = newLeft + 'px';
             if (newLeft > barWidth / 2) {
               flyText.classList.add('footer-madtrip__fly-text--right');
             } else {
               flyText.classList.remove('footer-madtrip__fly-text--right');
             }
          }

          // Desktop logic fix: 
          // Since it moves away on hover, user can't click it easily.
          // Trigger the 'nahi jayega' text popup unconditionally just like we do for touch on mobile!
          showText();
        };

        flyWrap.addEventListener('mouseenter', moveFly);
        flyWrap.addEventListener('touchstart', moveFly, { passive: false });
        flyWrap.addEventListener('click', showText);
        
        bottomBar.appendChild(flyWrap);
      }
    }

    // Initial render
    renderFlies();

    // Re-render when window size changes
    let resizeTimer;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(renderFlies, 200);
    });

    // Accordion functionality for mobile menus
    const menuHeaders = document.querySelectorAll('.footer-madtrip__menu-header');
    menuHeaders.forEach(header => {
      header.addEventListener('click', () => {
        if (window.innerWidth < 480) {
          const col = header.closest('.footer-madtrip__menu-col');
          // Close others
          const allCols = document.querySelectorAll('.footer-madtrip__menu-col');
          allCols.forEach(c => {
            if (c !== col) {
               c.classList.remove('is-active');
            }
          });
          // Toggle current
          col.classList.toggle('is-active');
        }
      });
    });
  });
</script>
