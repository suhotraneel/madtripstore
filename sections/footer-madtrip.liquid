        <div class="footer-madtrip__menu-col">
          <div class="footer-madtrip__menu-header">
            <h3 class="footer-madtrip__menu-title">
               {% if section.settings.menu_about != blank %}
                {{ linklists[section.settings.menu_about].title }}
              {% else %}
                About
              {% endif %}
            </h3>
            <span class="footer-madtrip__menu-icon">
              <span class="footer-madtrip__accordion-icon">
                {% if section.settings.accordion_icon != blank %}
                  {{ section.settings.accordion_icon }}
