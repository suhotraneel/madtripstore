{"name":"t:sections.footer.name","type":"footer","sections":{"custom_liquid_xWzF7w":{"type":"custom-liquid","disabled":true,"name":"t:sections.custom-liquid.presets.name","settings":{"custom_liquid":"<section class=\"carousel\">\n\n  <!-- Background Images (crossfade) -->\n  <img id=\"bg1\" class=\"carousel-bg\" src=\"\" alt=\"\" width=\"1920\" height=\"1080\" \/>\n  <img id=\"bg2\" class=\"carousel-bg is-hidden\" src=\"\" alt=\"\" width=\"1920\" height=\"1080\" \/>\n\n  <!-- Content -->\n  <div class=\"carousel-content\">\n    <div class=\"carousel-text\">\n      <p id=\"quote\" class=\"carousel-quote fade show\"><\/p>\n      <p id=\"author\" class=\"carousel-author fade show\"><\/p>\n    <\/div>\n\n    <div class=\"carousel-controls\">\n      <button id=\"prev\" class=\"nav-btn\" aria-label=\"Previous slide\">\n        <img\n          src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0655\/0667\/2825\/files\/chevron_left.svg?v=1769011900\"\n          alt=\"\"\n          width=\"16\"\n          height=\"16\"\n        \/>\n      <\/button>\n\n      <div id=\"dots\" class=\"dots\"><\/div>\n\n      <button id=\"next\" class=\"nav-btn\" aria-label=\"Next slide\">\n        <img\n          src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0655\/0667\/2825\/files\/chevron_right.svg?v=1769011900\"\n          alt=\"\"\n          width=\"16\"\n          height=\"16\"\n        \/>\n      <\/button>\n    <\/div>\n  <\/div>\n\n<\/section>\n\n\n\n<style>\n.carousel {\n  position: relative;\n  width: 100%;\n  height: 640px;\n  overflow: hidden;\n  font-family: \"Pally Variable\";\n  isolation: isolate;\n}\n\n\/* SHOPIFY-SAFE OVERLAY *\/\n.carousel::before {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  z-index: 1;\n  pointer-events: none;\n  background: linear-gradient(\n    to bottom,\n    rgba(15, 33, 39, 0),\n    rgba(15, 33, 39, 0.7),\n    #0f2127\n  );\n}\n\n@media (min-width: 768px) {\n  .carousel {\n    height: 480px;\n  }\n  .carousel::before {\n    background: linear-gradient(\n      to left,\n      rgba(15, 33, 39, 0),\n      #0f2127\n    );\n  }\n}\n\n@media (min-width: 1024px) {\n  .carousel {\n    height: 440px;\n  }\n}\n\n\/* BACKGROUND IMAGES *\/\n\n.carousel-bg {\n  position: absolute;\n  inset: 0;\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  transition: opacity 1s ease;\n  z-index: 0;\n}\n\n.carousel-bg.is-hidden {\n  opacity: 0;\n}\n\n\/* CONTENT *\/\n\n.carousel-content {\n  position: relative;\n  z-index: 2;\n  height: 100%;\n  max-width: 1400px;\n  margin: 0 auto;\n  padding: 0 24px 48px;\n\n  display: flex;\n  flex-direction: column;\n  justify-content: flex-end;\n  align-items: center;\n  gap: 40px;\n}\n\n@media (min-width: 768px) {\n  .carousel-content {\n    padding: 0 50px 96px;\n    align-items: flex-start;\n    gap: 48px;\n  }\n}\n\n.carousel-text {\n  color: #eaeaea;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 20px;\n  text-align: center;\n}\n\n@media (min-width: 768px) {\n  .carousel-text {\n    align-items: flex-start;\n    text-align: left;\n    gap: 24px;\n  }\n}\n\n.carousel-quote {\n  margin: 0;\n  font-size: 20px;\n  font-weight: 700;\n  line-height: 27px;\n  max-width: 440px;\n}\n\n@media (min-width: 480px) {\n  .carousel-quote {\n    font-size: 24px;\n    line-height: 32px;\n    max-width: 560px;\n  }\n}\n\n@media (min-width: 768px) {\n  .carousel-quote {\n    font-size: 28px;\n    line-height: 38px;\n    max-width: 66%;\n  }\n}\n\n.carousel-author {\n  margin: 0;\n  font-size: 12px;\n  font-weight: 400;\n  line-height: 16px;\n}\n\n@media (min-width: 480px) {\n  .carousel-author {\n    font-size: 14px;\n    line-height: 19px;\n  }\n}\n\n\/* FADE TEXT *\/\n\n.fade {\n  opacity: 0;\n  transition: opacity 0.4s ease;\n}\n\n.fade.show {\n  opacity: 1;\n}\n\n\/* CONTROLS *\/\n\n.carousel-controls {\n  display: flex;\n  align-items: center;\n  gap: 20px;\n}\n\n.nav-btn {\n  width: 40px;\n  height: 40px;\n  border-radius: 50%;\n  background: rgba(58, 191, 239, 0.16);\n  border: none;\n  cursor: pointer;\n\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.nav-btn img {\n  width: 16px;\n  height: 16px;\n  display: block;\n}\n\n@media (hover: hover) and (pointer: fine) {\n  .nav-btn:hover {\n    background: rgba(58, 191, 239, 0.24);\n  }\n}\n\n.nav-btn:active {\n  background: rgba(58, 191, 239, 0.32);\n}\n\n.dots {\n  display: flex;\n  gap: 10px;\n}\n\n.dots button {\n  background: none;\n  border: none;\n  padding: 0;\n  cursor: pointer;\n}\n\n.dots img {\n  opacity: 0.5;\n  transition: opacity 0.3s ease;\n}\n\n.dots img.active {\n  opacity: 1;\n}\n<\/style>\n\n\n<script>\n  const slides = [\n    {\n      quote:\n        '\"I just wanted to let you know that I am in LOVE with my suit. What a liberating option for non-binary folks!\"',\n      author: \"H. from Mumbai\",\n      img:\n        \"https:\/\/images.unsplash.com\/photo-1529626455594-4ff0802cfb7e?auto=format&fit=crop&w=1600&q=80\",\n    },\n    {\n      quote:\n        '\"The quality is absolutely incredible. I’ve never felt more comfortable and confident.\"',\n      author: \"S. from Tokyo\",\n      img:\n        \"https:\/\/images.unsplash.com\/photo-1516763449302-78450e5a507d?auto=format&fit=crop&w=1600&q=80\",\n    },\n    {\n      quote:\n        '\"Finally found a brand that understands style and inclusivity.\"',\n      author: \"A. from London\",\n      img:\n        \"https:\/\/images.unsplash.com\/photo-1583264277168-58ceba4b84e7?auto=format&fit=crop&w=1600&q=80\",\n    },\n    {\n      quote:\n        '\"The attention to detail is remarkable. This is fashion done right!\"',\n      author: \"M. from Berlin\",\n      img:\n        \"https:\/\/images.unsplash.com\/photo-1657651315305-a1b608182927?auto=format&fit=crop&w=1600&q=80\",\n    },\n  ];\n\n  let index = 0;\n  let activeBg = 1;\n\n  const bg1 = document.getElementById(\"bg1\");\n  const bg2 = document.getElementById(\"bg2\");\n  const quote = document.getElementById(\"quote\");\n  const author = document.getElementById(\"author\");\n  const dots = document.getElementById(\"dots\");\n\n  const AUTO_PLAY_DELAY = 4000;\n  let timer = null;\n  const dotImgs = [];\n\n  function createDots() {\n    dots.innerHTML = \"\";\n    dotImgs.length = 0;\n\n    slides.forEach((_, i) => {\n      const btn = document.createElement(\"button\");\n      const img = document.createElement(\"img\");\n\n      img.src =\n        \"https:\/\/cdn.shopify.com\/s\/files\/1\/0655\/0667\/2825\/files\/inactive_carousel.svg?v=1769011901\";\n\n      btn.appendChild(img);\n\n      btn.addEventListener(\"click\", () => {\n        stopAuto();\n        index = i;\n        render();\n        startAuto();\n      });\n\n      dots.appendChild(btn);\n      dotImgs.push(img);\n    });\n  }\n\n  function updateDots() {\n    dotImgs.forEach((img, i) => {\n      const active = i === index;\n\n      img.src = active\n        ? \"https:\/\/cdn.shopify.com\/s\/files\/1\/0655\/0667\/2825\/files\/active_carousel.svg?v=1769011901\"\n        : \"https:\/\/cdn.shopify.com\/s\/files\/1\/0655\/0667\/2825\/files\/inactive_carousel.svg?v=1769011901\";\n\n      img.classList.toggle(\"active\", active);\n    });\n  }\n\n  function render() {\n    const slide = slides[index];\n\n    \/\/ Background crossfade\n    if (activeBg === 1) {\n      bg2.src = slide.img;\n      bg2.classList.remove(\"is-hidden\");\n      bg1.classList.add(\"is-hidden\");\n      activeBg = 2;\n    } else {\n      bg1.src = slide.img;\n      bg1.classList.remove(\"is-hidden\");\n      bg2.classList.add(\"is-hidden\");\n      activeBg = 1;\n    }\n\n    \/\/ Text fade\n    quote.classList.remove(\"show\");\n    author.classList.remove(\"show\");\n\n    setTimeout(() => {\n      quote.textContent = slide.quote;\n      author.textContent = slide.author;\n\n      quote.classList.add(\"show\");\n      author.classList.add(\"show\");\n    }, 150);\n\n    updateDots();\n  }\n\n  function next() {\n    index = (index + 1) % slides.length;\n    render();\n  }\n\n  function prev() {\n    index = (index - 1 + slides.length) % slides.length;\n    render();\n  }\n\n  function startAuto() {\n    stopAuto();\n    timer = setInterval(next, AUTO_PLAY_DELAY);\n  }\n\n  function stopAuto() {\n    if (timer) {\n      clearInterval(timer);\n      timer = null;\n    }\n  }\n\n  document.getElementById(\"next\").addEventListener(\"click\", () => {\n    stopAuto();\n    next();\n    startAuto();\n  });\n\n  document.getElementById(\"prev\").addEventListener(\"click\", () => {\n    stopAuto();\n    prev();\n    startAuto();\n  });\n\n  createDots();\n  render();\n  startAuto();\n<\/script>","color_scheme":"","padding_top":0,"padding_bottom":0}},"footer_custom_RGX8KV":{"type":"footer-madtrip","name":"Custom Footer","settings":{"bg_color":"#111111","logo":"shopify:\/\/shop_images\/main_logo.svg","logo_width":400,"menu_below_logo":"","accordion_icon":"<svg xmlns=\"http:\/\/www.w3.org\/2000\/svg\" width=\"16\" height=\"9\" viewbox=\"0 0 16 9\" fill=\"none\">\n  <path d=\"M14.26 0.0104066C14.2794 0.0129106 14.2924 0.0155801 14.3042 0.016907L14.3133 0.016907L14.3289 0.0182071L14.3432 0.0195072C14.5726 0.0444402 14.8066 0.0801148 15.0478 0.137816C15.1873 0.168768 15.3536 0.200766 15.5107 0.241824L15.5094 0.244424C15.5654 0.256381 15.652 0.276925 15.7317 0.32503C15.803 0.368276 15.9025 0.455877 15.941 0.59155C15.9466 0.601565 15.9535 0.610675 15.9579 0.620152C15.981 0.670229 15.9986 0.733909 15.9995 0.804766C16.0191 1.77117 15.4695 2.54721 14.6994 2.96163C14.5717 3.03599 14.4495 3.09832 14.3393 3.15144C14.2255 3.20627 14.1317 3.24995 14.0415 3.29705C13.8684 3.38763 13.7479 3.47281 13.6528 3.59997C13.6528 3.59997 13.6503 3.60437 13.645 3.61297C13.6391 3.62263 13.6313 3.63574 13.6229 3.65068C13.606 3.68081 13.5875 3.71702 13.5696 3.75208C13.5521 3.78649 13.5358 3.81909 13.5241 3.84309C13.5202 3.85107 13.5152 3.85815 13.5124 3.86389C13.2998 4.43115 13.1395 5.12444 12.6036 5.66063L12.4255 5.83874L12.4151 5.83224C12.0985 