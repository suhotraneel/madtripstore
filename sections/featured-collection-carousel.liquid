{% comment %}
  featured-collection-carousel.liquid
  ---
  A full-width autoplay product carousel that pulls products from a Shopify
  collection chosen in the Theme Editor. Each slide shows the product image
  inside a customisable SVG blob/mask shape (different shapes for desktop
  and mobile, breakpoint 768 px). Navigation chevrons and the "Buy Now"
  button use the brand yellow (#FFDE17) palette with a teal/cyan accent
  matching the provided design reference.
{% endcomment %}

<style>
  /* =========================================================
     ROOT TOKENS — all sizing / colour decisions live here
  ========================================================= */

  #fcc-{{ section.id }} {
    {%- if section.settings.enable_top_clip -%}
      margin-top: 0;
    {%- endif -%}
    --fcc-bg:            {{ section.settings.background_color | default: '#FFDE17' }};
    --fcc-accent:        #29C4D4;
    --fcc-btn-radius:    9999px;
    --fcc-transition:    0.45s cubic-bezier(0.4, 0, 0.2, 1);
    --fcc-chevron-size:  44px;
    --svg-cut-height-top: calc(100vw * 56 / 2463);
    --svg-cut-height-bottom: calc(100vw * 56 / 2463);
    --tv-aspect-desktop: {% if section.settings.tv_desktop != blank %}{{ section.settings.tv_desktop.aspect_ratio }}{% else %}1.112524{% endif %};
    --tv-aspect-mobile: {% if section.settings.tv_mobile != blank %}{{ section.settings.tv_mobile.aspect_ratio }}{% else %}0.819237{% endif %};

    position: relative;
    width: 100%;
    /* height hugs content */
    background-color: var(--fcc-bg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: calc(48px + {% if section.settings.enable_top_clip %}var(--svg-cut-height-top){% else %}0px{% endif %}) 0 calc(56px + {% if section.settings.enable_bottom_clip %}var(--svg-cut-height-bottom){% else %}0px{% endif %});
    box-sizing: border-box;
    z-index: 1;

    {%- if section.settings.enable_top_clip or section.settings.enable_bottom_clip -%}
      {%- capture top_svg -%}<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 2463 56' preserveAspectRatio='none'><path fill='black' d='M2462.16 25.9036C2444.34 23.2552 2427.84 16.5352 2409.51 15.1517C2392.98 13.9262 2375.31 14.282 2359.39 18.8674C2350.35 21.4764 2340.3 28.1568 2331.63 29.6589C2294.54 36.1022 2257.89 0.328134 2214.87 4.24154C2182.92 7.16672 2154.72 32.7027 2125.39 36.4185C2094.72 40.2923 2068.23 17.1281 2036.25 17.1281C1991.29 17.1281 1978.76 48.0796 1927.03 30.2123C1893.44 18.6302 1874.9 0.209546 1835.63 4.24154C1808.34 7.0086 1781.49 28.2754 1754.28 30.1728C1733.84 31.5959 1718.21 17.7211 1698.5 15.3493C1641.13 8.43166 1615.41 33.6909 1567.17 40.4109C1533.66 45.1149 1501.85 22.346 1472.49 23.6505C1450.96 24.5992 1417.7 47.7634 1392.45 51.2024C1338.72 58.5154 1322.91 37.4858 1278.75 20.5276C1247.2 8.43166 1225.6 28.0382 1194.16 32.0702C1180.43 33.8491 1158.93 33.7305 1145.27 31.7935C1120.28 28.2359 1089.93 9.49896 1066.36 18.3535C1023.63 34.4420 1013.03 55.9064 960.023 51.7954C918.165 48.5540 889.057 17.8001 845.887 26.8524C801.406 36.1813 795.431 46.8542 746.651 33.4142C706.213 22.2669 681.44 9.89425 636.704 15.3098C622.605 17.0095 610.219 26.0618 597.505 28.7893C564.426 35.865 530.072 7.32483 497.576 4.24154C451.31 -0.146219 438.377 20.8439 400.271 32.426C357.174 45.5497 331.891 15.626 288.903 17.1677C259.431 18.2349 236.99 38.3554 209.522 36.7347C173.273 34.6001 140.814 3.84625 100.74 3.01614C64.6744 2.26508 35.7851 28.3545 0.15625 30.2123 L 0 56 L 2463 56 Z'/></svg>{%- endcapture -%}
      {%- capture bottom_svg -%}<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 2463 56' preserveAspectRatio='none'><path fill='black' d='M2462.16 25.9036C2444.34 23.2552 2427.84 16.5352 2409.51 15.1517C2392.98 13.9262 2375.31 14.282 2359.39 18.8674C2350.35 21.4764 2340.3 28.1568 2331.63 29.6589C2294.54 36.1022 2257.89 0.328134 2214.87 4.24154C2182.92 7.16672 2154.72 32.7027 2125.39 36.4185C2094.72 40.2923 2068.23 17.1281 2036.25 17.1281C1991.29 17.1281 1978.76 48.0796 1927.03 30.2123C1893.44 18.6302 1874.9 0.209546 1835.63 4.24154C1808.34 7.0086 1781.49 28.2754 1754.28 30.1728C1733.84 31.5959 1718.21 17.7211 1698.5 15.3493C1641.13 8.43166 1615.41 33.6909 1567.17 40.4109C1533.66 45.1149 1501.85 22.346 1472.49 23.6505C1450.96 24.5992 1417.7 47.7634 1392.45 51.2024C1338.72 58.5154 1322.91 37.4858 1278.75 20.5276C1247.2 8.43166 1225.6 28.0382 1194.16 32.0702C1180.43 33.8491 1158.93 33.7305 1145.27 31.7935C1120.28 28.2359 1089.93 9.49896 1066.36 18.3535C1023.63 34.4420 1013.03 55.9064 960.023 51.7954C918.165 48.5540 889.057 17.8001 845.887 26.8524C801.406 36.1813 795.431 46.8542 746.651 33.4142C706.213 22.2669 681.44 9.89425 636.704 15.3098C622.605 17.0095 610.219 26.0618 597.505 28.7893C564.426 35.865 530.072 7.32483 497.576 4.24154C451.31 -0.146219 438.377 20.8439 400.271 32.426C357.174 45.5497 331.891 15.626 288.903 17.1677C259.431 18.2349 236.99 38.3554 209.522 36.7347C173.273 34.6001 140.814 3.84625 100.74 3.01614C64.6744 2.26508 35.7851 28.3545 0.15625 30.2123 L 0 0 L 2463 0 Z'/></svg>{%- endcapture -%}
      {%- capture stroke_svg -%}<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 2463 56' preserveAspectRatio='none'><path fill='none' stroke='black' stroke-width='6' d='M2462.16 25.9036C2444.34 23.2552 2427.84 16.5352 2409.51 15.1517C2392.98 13.9262 2375.31 14.282 2359.39 18.8674C2350.35 21.4764 2340.3 28.1568 2331.63 29.6589C2294.54 36.1022 2257.89 0.328134 2214.87 4.24154C2182.92 7.16672 2154.72 32.7027 2125.39 36.4185C2094.72 40.2923 2068.23 17.1281 2036.25 17.1281C1991.29 17.1281 1978.76 48.0796 1927.03 30.2123C1893.44 18.6302 1874.9 0.209546 1835.63 4.24154C1808.34 7.0086 1781.49 28.2754 1754.28 30.1728C1733.84 31.5959 1718.21 17.7211 1698.5 15.3493C1641.13 8.43166 1615.41 33.6909 1567.17 40.4109C1533.66 45.1149 1501.85 22.346 1472.49 23.6505C1450.96 24.5992 1417.7 47.7634 1392.45 51.2024C1338.72 58.5154 1322.91 37.4858 1278.75 20.5276C1247.2 8.43166 1225.6 28.0382 1194.16 32.0702C1180.43 33.8491 1158.93 33.7305 1145.27 31.7935C1120.28 28.2359 1089.93 9.49896 1066.36 18.3535C1023.63 34.442 1013.03 55.9064 960.023 51.7954C918.165 48.554 889.057 17.8001 845.887 26.8524C801.406 36.1813 795.431 46.8542 746.651 33.4142C706.213 22.2669 681.44 9.89425 636.704 15.3098C622.605 17.0095 610.219 26.0618 597.505 28.7893C564.426 35.865 530.072 7.32483 497.576 4.24154C451.31 -0.146219 438.377 20.8439 400.271 32.426C357.174 45.5497 331.891 15.626 288.903 17.1677C259.431 18.2349 236.99 38.3554 209.522 36.7347C173.273 34.6001 140.814 3.84625 100.74 3.01614C64.6744 2.26508 35.7851 28.3545 0.15625 30.2123'/></svg>{%- endcapture -%}

      -webkit-mask-image: 
        {% if section.settings.enable_top_clip %}url("data:image/svg+xml;utf8,{{ top_svg }}"),{% endif %}
        {% if section.settings.enable_bottom_clip %}url("data:image/svg+xml;utf8,{{ bottom_svg }}"),{% endif %}
        linear-gradient(black, black);
      -webkit-mask-size: 
        {% if section.settings.enable_top_clip %}100% var(--svg-cut-height-top),{% endif %}
        {% if section.settings.enable_bottom_clip %}100% var(--svg-cut-height-bottom),{% endif %}
        100% calc(100% - {% if section.settings.enable_top_clip %}var(--svg-cut-height-top){% else %}0px{% endif %} - {% if section.settings.enable_bottom_clip %}var(--svg-cut-height-bottom){% else %}0px{% endif %} + 2px);
      -webkit-mask-position: 
        {% if section.settings.enable_top_clip %}top center,{% endif %}
        {% if section.settings.enable_bottom_clip %}bottom center,{% endif %}
        0 {% if section.settings.enable_top_clip %}calc(var(--svg-cut-height-top) - 1px){% else %}0px{% endif %};
      -webkit-mask-repeat: no-repeat;
      
      mask-image: 
        {% if section.settings.enable_top_clip %}url("data:image/svg+xml;utf8,{{ top_svg }}"),{% endif %}
        {% if section.settings.enable_bottom_clip %}url("data:image/svg+xml;utf8,{{ bottom_svg }}"),{% endif %}
        linear-gradient(black, black);
      mask-size: 
        {% if section.settings.enable_top_clip %}100% var(--svg-cut-height-top),{% endif %}
        {% if section.settings.enable_bottom_clip %}100% var(--svg-cut-height-bottom),{% endif %}
        100% calc(100% - {% if section.settings.enable_top_clip %}var(--svg-cut-height-top){% else %}0px{% endif %} - {% if section.settings.enable_bottom_clip %}var(--svg-cut-height-bottom){% else %}0px{% endif %} + 2px);
      mask-position: 
        {% if section.settings.enable_top_clip %}top center,{% endif %}
        {% if section.settings.enable_bottom_clip %}bottom center,{% endif %}
        0 {% if section.settings.enable_top_clip %}calc(var(--svg-cut-height-top) - 1px){% else %}0px{% endif %};
      mask-repeat: no-repeat;
    {%- endif -%}
  }

  #fcc-{{ section.id }}::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: var(--svg-cut-height-top);
      display: {% if section.settings.enable_top_clip %}block{% else %}none{% endif %};
      pointer-events: none;
      z-index: 5;
      background-image: url("data:image/svg+xml;utf8,{{ stroke_svg }}");
      background-size: 100% var(--svg-cut-height-top);
      background-position: top center;
      background-repeat: no-repeat;
  }

  #fcc-{{ section.id }}::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      width: 100%;
      height: var(--svg-cut-height-bottom);
      display: {% if section.settings.enable_bottom_clip %}block{% else %}none{% endif %};
      pointer-events: none;
      z-index: 5;
      background-image: url("data:image/svg+xml;utf8,{{ stroke_svg }}");
      background-size: 100% var(--svg-cut-height-bottom);
      background-position: bottom center;
      background-repeat: no-repeat;
  }

  /* =========================================================
     TV SVG LAYOUT
  ========================================================= */
  .fcc-tv-wrapper {
    position: relative;
    width: 90%;
    max-width: calc(85vh * var(--tv-aspect-desktop));
    margin: 0 auto 16px;
  }

  .fcc-tv-bg {
    display: block;
  }
  .fcc-tv-bg svg,
  .fcc-tv-bg img {
    width: 100%;
    height: auto;
    display: block;
  }

  .fcc-tv-mobile { display: none; }

  @media (max-width: 768px) {
    .fcc-tv-desktop { display: none !important; }
    .fcc-tv-mobile { display: block !important; }
    
    .fcc-tv-wrapper {
      width: 95%;
      max-width: calc(90vh * var(--tv-aspect-mobile));
    }
  }

  /* =========================================================
     MASK STAGE — absolutely positioned over the TV screen
  ========================================================= */
  .fcc-mask-stage {
    position: absolute;
    /* Desktop Screen Box */
    top: 18.50%;
    left: 11.64%;
    width: 73.10%;
    height: 58.20%;
    margin: 0;
  }

  @media (max-width: 768px) {
    .fcc-mask-stage {
      /* Mobile Screen Box */
      top: 20.25%;
      left: 12.50%;
      width: 71.48%;
      height: 56.68%;
    }
  }

  /* TV Button Overlays */
  .fcc-tv-control {
    position: absolute;
    background: transparent;
    border: none;
    cursor: pointer;
    z-index: 10;
  }
  .fcc-tv-prev { top: 78.5%; left: 38.50%; width: 7.66%; height: 10.5%; }
  .fcc-tv-pause { top: 78.5%; left: 46.16%; width: 7.66%; height: 10.5%; }
  .fcc-tv-next { top: 78.5%; left: 53.82%; width: 7.66%; height: 10.5%; }

  @media (max-width: 768px) {
    .fcc-tv-prev { top: 79.5%; left: 34%; width: 10.66%; height: 10.5%; }
    .fcc-tv-pause { top: 79.5%; left: 44.66%; width: 10.66%; height: 10.5%; }
    .fcc-tv-next { top: 79.5%; left: 55.32%; width: 10.66%; height: 10.5%; }
  }


  .fcc-header {
    font-family: 'Krugat', system-ui, sans-serif;
    font-size: 64px;
    line-height: 1.2;
    color: #111111;
    text-align: center;
    margin-bottom: 40px;
    margin-top: 0;
    word-wrap: break-word;
  }

  @media (max-width: 768px) {
    .fcc-header {
      font-size: 40px;
      margin-bottom: 48px;
    }
  }

  /* =========================================================
     SLIDES — each slide is absolutely stacked inside the stage.
     The mask stays at the center. Images flicker on transition.
  ========================================================= */

  .fcc-slide {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #1a1a1a;
    opacity: 0;
    visibility: hidden;
    z-index: 1;
    /* CSS mask clips the slide to the blob shape on desktop */
    -webkit-mask-image: var(--fcc-mask-desktop);
    mask-image: var(--fcc-mask-desktop);
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-position: center;
    mask-position: center;
  }

  @media (max-width: 768px) {
    .fcc-slide {
      -webkit-mask-image: var(--fcc-mask-mobile);
      mask-image: var(--fcc-mask-mobile);
    }
  }

  @keyframes tvFlicker {
    0%   { opacity: 0.1; filter: brightness(2) contrast(1.5); }
    10%  { opacity: 1;   filter: brightness(1) contrast(1); }
    20%  { opacity: 0.2; }
    30%  { opacity: 1; }
    40%  { opacity: 0.5; }
    50%  { opacity: 1; }
    60%  { opacity: 0.3; }
    70%  { opacity: 1; }
    80%  { opacity: 0.8; }
    90%  { opacity: 1; }
    100% { opacity: 1; }
  }

  /* Active slide sits at the center */
  .fcc-slide.is-active {
    opacity: 1;
    visibility: visible;
    z-index: 2;
    animation: tvFlicker 0.4s ease-out both;
  }

  .fcc-slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;   /* fill the blob — no letterboxing */
    display: block;
  }

  /* =========================================================
     PAUSE OVERLAY
  ========================================================= */
  .fcc-pause-overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 6;
    opacity: 0;
    transition: opacity 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    /* clip to the same blob shape as the slides */
    -webkit-mask-image: var(--fcc-mask-desktop);
    mask-image: var(--fcc-mask-desktop);
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-position: center;
    mask-position: center;
  }

  .fcc-pause-overlay.is-visible {
    opacity: 1;
    background-color: rgba(0, 0, 0, 0.2);
  }

  .fcc-pause-overlay img {
    opacity: 0.5;
  }

  @media (max-width: 768px) {
    .fcc-pause-overlay {
      -webkit-mask-image: var(--fcc-mask-mobile);
      mask-image: var(--fcc-mask-mobile);
    }
  }

  /* =========================================================
     RESPONSIVE TWEAKS
  ========================================================= */
  @media (max-width: 768px) {
    #fcc-{{ section.id }} {
      padding: clamp(48px, calc(48px + 2vw), 64px) 0;
    }
  }
</style>

{%- liquid
  assign col    = section.settings.collection
  assign products = col.products
  assign product_count = products.size
-%}

<section
  id="fcc-{{ section.id }}"
  aria-label="{{ section.settings.section_aria_label | default: 'Featured products carousel' }}"
  style="position: relative;"
>
  {%- liquid
    assign col           = section.settings.collection
    assign products      = col.products
    assign product_count = products.size

    assign mask_desktop_url = section.settings.mask_desktop | image_url: width: 1200
    assign mask_mobile_url  = section.settings.mask_mobile  | image_url: width: 800
  -%}

  {%- comment -%} CSS vars for mask-image are set on the stage so .fcc-slide inherits them {%- endcomment -%}

  {% if product_count > 0 %}

    {%- if section.settings.section_header != blank -%}
      <h2 class="fcc-header">{{ section.settings.section_header | escape }}</h2>
    {%- endif -%}

    {%- comment -%} ── MASK + SLIDES ── {%- endcomment -%}
    <div class="fcc-tv-wrapper" id="fccTvWrapper-{{ section.id }}">

      <div class="fcc-tv-bg fcc-tv-desktop">
        {%- if section.settings.tv_desktop != blank -%}
          <img src="{{ section.settings.tv_desktop | image_url: width: 2400 }}" alt="" loading="lazy">
        {%- else -%}
          <svg viewBox="0 0 4024 3617" style="background:#444; width:100%; height:auto;"></svg>
        {%- endif -%}
      </div>

      <div class="fcc-tv-bg fcc-tv-mobile">
        {%- if section.settings.tv_mobile != blank -%}
          <img src="{{ section.settings.tv_mobile | image_url: width: 1200 }}" alt="" loading="lazy">
        {%- else -%}
          <svg viewBox="0 0 2964 3618" style="background:#444; width:100%; height:auto;"></svg>
        {%- endif -%}
      </div>

      <div
        class="fcc-mask-stage"
        id="fccMaskStage-{{ section.id }}"
        style="
          --fcc-mask-desktop: {% if section.settings.mask_desktop != blank %}{{ mask_desktop_url | prepend: 'url(' | append: ')' }}{% else %}none{% endif %};
          --fcc-mask-mobile:  {% if section.settings.mask_mobile != blank %}{{ mask_mobile_url | prepend: 'url(' | append: ')' }}{% else %}none{% endif %};
        "
      >
        {%- comment -%}
          Slides — each sits absolutely over the stage and carries its own
          CSS mask-image (set via custom properties on the stage element)
          so the entire masked blob unit crossfades as one piece.
        {%- endcomment -%}
      {%- for product in products -%}
        <div class="fcc-slide{% if forloop.first %} is-active{% endif %}" data-index="{{ forloop.index0 }}">
          <a href="{{ product.url }}" style="display: block; width: 100%; height: 100%;">
            <img
              src="{{ product.featured_image | image_url: width: 800 }}"
              alt="{{ product.featured_image.alt | escape | default: product.title | escape }}"
              loading="{{ forloop.first | iif: 'eager', 'lazy' }}"
              width="800"
              height="800"
            >
          </a>
        </div>
      {%- endfor -%}

        <div class="fcc-pause-overlay" id="fccPauseOverlay-{{ section.id }}" aria-hidden="true">
          {%- if section.settings.pause_overlay_svg != blank -%}
            <img src="{{ section.settings.pause_overlay_svg | image_url: width: 200 }}" alt="" draggable="false" style="width: 25%; height: auto; display: block;">
          {%- endif -%}
        </div>

      </div><!-- /.fcc-mask-stage -->

      <button class="fcc-tv-control fcc-tv-prev" id="fccTvPrev-{{ section.id }}" aria-label="Previous product"></button>
      <button class="fcc-tv-control fcc-tv-pause" id="fccTvPause-{{ section.id }}" aria-label="Pause/Play carousel"></button>
      <button class="fcc-tv-control fcc-tv-next" id="fccTvNext-{{ section.id }}" aria-label="Next product"></button>

    </div><!-- /.fcc-tv-wrapper -->

  {% else %}

    {%- comment -%} Editor placeholder when no collection is picked {%- endcomment -%}
    {%- if request.design_mode -%}
      <div style="padding:60px 24px; text-align:center; opacity:0.5; font-family:sans-serif;">
        <p style="font-size:18px; margin:0 0 8px;">Featured Collection Carousel</p>
        <p style="font-size:14px; margin:0;">Select a collection in the section settings to display products here.</p>
      </div>
    {%- endif -%}

  {% endif %}

</section>

<script>
(function () {
  'use strict';

  /* ── configuration ──────────────────────────────────────── */
  const SECTION_ID      = '{{ section.id }}';
  const AUTOPLAY_DELAY  = parseFloat({{ section.settings.autoplay_delay | default: 3000 }}) || 3000;  /* ms */
  const AUTOPLAY_ACTIVE = {{ section.settings.autoplay | default: true }};
  const PRODUCT_URLS    = [
    {%- for product in products -%}
      "{{ product.url }}"{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ];

  /* ── element refs ───────────────────────────────────────── */
  const wrapper     = document.getElementById('fccTvWrapper-' + SECTION_ID);
  const stage       = document.getElementById('fccMaskStage-' + SECTION_ID);
  const prevBtn     = document.getElementById('fccTvPrev-'    + SECTION_ID);
  const pauseBtn    = document.getElementById('fccTvPause-'   + SECTION_ID);
  const nextBtn     = document.getElementById('fccTvNext-'    + SECTION_ID);


  if (!stage || PRODUCT_URLS.length === 0) return;

  const slides = Array.from(stage.querySelectorAll('.fcc-slide'));
  if (slides.length === 0) return;

  /* ── state ──────────────────────────────────────────────── */
  let current   = 0;
  const total   = slides.length;

  /* ── render & autoplay tracking ─────────────────────────── */
  var isAnimating = false;
  var isPaused = false;
  var timePassed = 0;
  var lastTick = null;
  var rafId = null;

  function resetAutoplay() {
    timePassed = 0;
  }

  function goTo(index, userInitiated) {
    var newIndex = ((index % total) + total) % total;
    if (newIndex === current || isAnimating) return;

    var outSlide = slides[current];
    var inSlide  = slides[newIndex];
    current = newIndex;
    isAnimating = true;

    /* ── TV FLICKER TRANSITION ───── */
    var FLICKER_MS = 400; // matches CSS animation duration

    outSlide.classList.remove('is-active');
    inSlide.classList.remove('is-active');
    void inSlide.offsetWidth; 
    inSlide.classList.add('is-active');

    setTimeout(function () {
      isAnimating = false;
    }, FLICKER_MS);

    /* instantly reset progress bar */
    if (AUTOPLAY_ACTIVE) {
      resetAutoplay();
    }
  }

  /* ── animation loop ─────────────────────────────────────── */

  /* ── pause overlay ──────────────────────────────────────── */
  var pauseOverlay = document.getElementById('fccPauseOverlay-' + SECTION_ID);

  function tick(timestamp) {
    if (!lastTick) lastTick = timestamp;
    var delta = timestamp - lastTick;
    lastTick = timestamp;

    if (!isPaused && AUTOPLAY_ACTIVE && !isAnimating) {
      timePassed += delta;

      if (timePassed >= AUTOPLAY_DELAY) {
        timePassed = 0;
        goTo(current + 1, false);
      }
    }

    rafId = requestAnimationFrame(tick);
  }

  /* ── button clicks ──────────────────────────────────────── */
  if (prevBtn) {
    prevBtn.addEventListener('click', function () { goTo(current - 1, true); });
  }
  if (nextBtn) {
    nextBtn.addEventListener('click', function () { goTo(current + 1, true); });
  }
  if (pauseBtn) {
    pauseBtn.addEventListener('click', function () {
      isPaused = !isPaused;
      if (isPaused) {
        wrapper.classList.add('is-paused');
        if (pauseOverlay) pauseOverlay.classList.add('is-visible');
      } else {
        wrapper.classList.remove('is-paused');
        if (pauseOverlay) pauseOverlay.classList.remove('is-visible');
      }
    });
  }

  /* ── touch / swipe (on the stage element) ───────────────── */
  var touchStartX = null;
  stage.addEventListener('touchstart', function (e) {
    touchStartX = e.changedTouches[0].clientX;
  }, { passive: true });

  stage.addEventListener('touchend', function (e) {
    if (touchStartX === null) return;
    var delta = e.changedTouches[0].clientX - touchStartX;
    touchStartX = null;
    if (Math.abs(delta) > 40) {
      goTo(delta < 0 ? current + 1 : current - 1, true);
    }
  }, { passive: true });

  /* ── keyboard ───────────────────────────────────────────── */
  document.addEventListener('keydown', function (e) {
    var rect = wrapper.getBoundingClientRect();
    var inView = rect.top < window.innerHeight && rect.bottom > 0;
    if (!inView) return;
    if (e.key === 'ArrowLeft')  { goTo(current - 1, true); e.preventDefault(); }
    if (e.key === 'ArrowRight') { goTo(current + 1, true); e.preventDefault(); }
  });

  /* ── init ───────────────────────────────────────────────── */
  resetAutoplay();
  goTo(0, false);
  rafId = requestAnimationFrame(tick);

})();
</script>

<script>
  function scrollToFeaturedSection() {
    if (window.location.hash.includes('continue-shopping-target')) {
      var section = document.getElementById('fcc-{{ section.id }}');
      if (section) {
        // Try immediately
        var y = section.getBoundingClientRect().top + window.pageYOffset - 100;
        window.scrollTo({ top: y, behavior: 'instant' });
        
        // And try again after a delay to override any conflicting scripts (like hero section or layout shifts)
        setTimeout(function() {
          var yDelayed = section.getBoundingClientRect().top + window.pageYOffset - 100;
          window.scrollTo({ top: yDelayed, behavior: 'smooth' });
        }, 500);

        setTimeout(function() {
          var yDelayed2 = section.getBoundingClientRect().top + window.pageYOffset - 100;
          window.scrollTo({ top: yDelayed2, behavior: 'smooth' });
        }, 1200);
      }
    }
  }

  document.addEventListener('DOMContentLoaded', scrollToFeaturedSection);
  window.addEventListener('load', scrollToFeaturedSection);
  window.addEventListener('hashchange', scrollToFeaturedSection);
</script>
