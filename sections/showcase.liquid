{% schema %}
{
  "name": "Showcase Carousel",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Spin & See"
    },
    {
      "type": "image_picker",
      "id": "svg_mask",
      "label": "SVG Mask Image",
      "info": "Upload an SVG image. Its aspect ratio will automatically size the carousel items."
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video (HTML5)",
          "info": "Overrides image if provided."
        },
        {
          "type": "text",
          "id": "caption_title",
          "label": "Caption Title",
          "default": "Title"
        },
        {
          "type": "text",
          "id": "caption_subtitle",
          "label": "Caption Subtitle",
          "default": "Subtitle"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Showcase Carousel",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: 60px;
    padding-bottom: 120px;
    overflow: hidden;
  }
  
  .showcase-header {
    text-align: center;
    margin-bottom: 60px;
  }
  .showcase-header h2 {
    font-size: 3rem;
    font-weight: 500;
    margin: 0;
  }

  .showcase-container {
    position: relative;
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    perspective: 1500px;
  }

  .showcase-scene {
    position: relative;
    /* Responsive widths, height is derived from aspect-ratio */
    width: min(30vw, 350px);
    aspect-ratio: {{ section.settings.svg_mask.aspect_ratio | default: 0.75 }};
    transform-style: preserve-3d;
    will-change: transform;
  }

  .showcase-item {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
  }

  .showcase-media-container {
    width: 100%;
    height: 100%;
    position: relative;
    background: #f4f4f4;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(0,0,0,0.2);
    transition: filter 0.4s ease;
    
    {% if section.settings.svg_mask != blank %}
      -webkit-mask-image: url('{{ section.settings.svg_mask | image_url }}');
      mask-image: url('{{ section.settings.svg_mask | image_url }}');
      -webkit-mask-size: 100% 100%;
      mask-size: 100% 100%;
      -webkit-mask-repeat: no-repeat;
      mask-repeat: no-repeat;
      -webkit-mask-position: center;
      mask-position: center;
      border-radius: 0;
      box-shadow: none;
    {% endif %}
  }

  .showcase-media {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .showcase-caption {
    position: absolute;
    bottom: -80px;
    left: 0;
    width: 100%;
    text-align: center;
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.5s ease, transform 0.5s ease;
    pointer-events: none;
  }

  .showcase-caption h3 {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 600;
    color: #000;
  }

  .showcase-caption p {
    margin: 4px 0 0;
    font-size: 0.9rem;
    color: #666;
  }

  .showcase-item.active .showcase-caption {
    opacity: 1;
    transform: translateY(0);
  }

  .showcase-item:not(.active) .showcase-media-container {
    filter: brightness(0.6);
  }

  @media screen and (max-width: 768px) {
    .showcase-header h2 {
      font-size: 2rem;
    }
    .showcase-scene {
      width: 55vw;
    }
  }
{%- endstyle -%}

<div class="section-{{ section.id }}-padding">
  {%- if section.settings.title != blank -%}
    <div class="showcase-header">
      <h2>{{ section.settings.title | escape }}</h2>
    </div>
  {%- endif -%}

  <showcase-carousel class="showcase-container">
    <div class="showcase-scene">
      {%- for block in section.blocks -%}
        <div class="showcase-item" {{ block.shopify_attributes }}>
          <div class="showcase-media-container">
            {%- if block.settings.video != blank -%}
              {{ block.settings.video | video_tag: image_size: '800x', autoplay: true, loop: true, muted: true, class: 'showcase-media' }}
            {%- elsif block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 800 }}" 
                   alt="{{ block.settings.image.alt | escape }}" 
                   class="showcase-media"
                   loading="lazy">
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'showcase-media placeholder-svg' }}
            {%- endif -%}
          </div>
          
          <div class="showcase-caption">
            {%- if block.settings.caption_title != blank -%}
              <h3>{{ block.settings.caption_title | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.caption_subtitle != blank -%}
              <p>{{ block.settings.caption_subtitle | escape }}</p>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </showcase-carousel>
</div>

<script>
  if (!customElements.get('showcase-carousel')) {
    class ShowcaseCarousel extends HTMLElement {
      constructor() {
        super();
        this.scene = this.querySelector('.showcase-scene');
        this.items = this.querySelectorAll('.showcase-item');
        if (!this.scene || this.items.length === 0) return;

        this.numItems = this.items.length;
        this.theta = 360 / this.numItems;
        this.radius = 0;
        
        this.currentRotation = 0;
        this.targetRotation = 0;
        this.isDragging = false;
        this.startX = 0;
        this.rotationAtStart = 0;
        this.isMobile = window.innerWidth <= 768;

        this.init();
        this.setupEvents();
        
        this.animate = this.animate.bind(this);
        requestAnimationFrame(this.animate);
      }

      init() {
        this.isMobile = window.innerWidth <= 768;
        const itemWidth = this.scene.offsetWidth;
        
        this.radius = Math.round((itemWidth / 2) / Math.tan(Math.PI / this.numItems));
        this.radius += this.isMobile ? 20 : 60;

        // Push scene back to anchor the front item at Z=0
        this.scene.style.transform = `translateZ(-${this.radius}px)`;
        
        this.updateActiveItem();
      }

      setupEvents() {
        let resizeTimer;
        window.addEventListener('resize', () => {
          clearTimeout(resizeTimer);
          resizeTimer = setTimeout(() => this.init(), 100);
        });

        this.addEventListener('mousemove', (e) => {
          if (this.isDragging || this.isMobile) return;
          
          const rect = this.getBoundingClientRect();
          const centerX = rect.left + rect.width / 2;
          const normalizedX = (e.clientX - centerX) / (rect.width / 2);
          const clampedX = Math.max(-1, Math.min(1, normalizedX));
          
          const maxRotation = this.theta * Math.floor(this.numItems / 2);
          this.targetRotation = -clampedX * maxRotation;
        });

        this.addEventListener('mouseleave', () => {
          if (!this.isMobile) {
            this.targetRotation = 0;
          }
        });

        this.addEventListener('touchstart', (e) => {
          this.isDragging = true;
          this.startX = e.touches[0].clientX;
          this.rotationAtStart = this.targetRotation;
        }, { passive: true });

        this.addEventListener('touchmove', (e) => {
          if (!this.isDragging) return;
          const currentX = e.touches[0].clientX;
          const diff = currentX - this.startX;
          const degreesPerPixel = 0.6;
          this.targetRotation = this.rotationAtStart + (diff * degreesPerPixel);
        }, { passive: true });

        this.addEventListener('touchend', () => {
          this.isDragging = false;
          this.targetRotation = Math.round(this.targetRotation / this.theta) * this.theta;
        });
      }

      updateActiveItem() {
        let normRot = (-this.currentRotation % 360);
        if (normRot < 0) normRot += 360;
        
        let activeIndex = Math.round(normRot / this.theta) % this.numItems;
        if (activeIndex === this.numItems) activeIndex = 0;

        this.items.forEach((item, index) => {
          if (index === activeIndex) {
            item.classList.add('active');
          } else {
            item.classList.remove('active');
          }
        });
      }

      animate() {
        const ease = 0.08;
        const diff = this.targetRotation - this.currentRotation;
        
        if (Math.abs(diff) > 0.01) {
          this.currentRotation += diff * ease;
          this.updateActiveItem();
        }

        // Ferris wheel math: Items always face forward (0deg rotateY)
        // while orbiting in a circle via pure translations.
        this.items.forEach((item, index) => {
          const itemAngle = this.theta * index;
          const absAngle = itemAngle + this.currentRotation;
          const angleRad = absAngle * Math.PI / 180;
          
          const x = Math.sin(angleRad) * this.radius;
          const z = Math.cos(angleRad) * this.radius;
          
          item.style.transform = `translate3d(${x}px, 0, ${z}px)`;
        });

        requestAnimationFrame(this.animate);
      }
    }
    customElements.define('showcase-carousel', ShowcaseCarousel);
  }
</script>
