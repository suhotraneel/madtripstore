{% schema %}
{
  "name": "Showcase Carousel",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Spin & See"
    },
    {
      "type": "image_picker",
      "id": "svg_mask",
      "label": "SVG Mask Image",
      "info": "Upload an SVG image. Its aspect ratio will automatically size the carousel items."
    },
    {
      "type": "range",
      "id": "overlap_desktop",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Desktop Overlap",
      "default": 30
    },
    {
      "type": "range",
      "id": "overlap_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Mobile Overlap",
      "default": 30
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video (HTML5)",
          "info": "Overrides image if provided."
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption Text",
          "default": "Caption text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Showcase Carousel",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: 60px;
    padding-bottom: 120px;
    overflow: hidden;
  }
  
  .showcase-header {
    text-align: center;
    margin-bottom: 60px;
  }
  .showcase-header h2 {
    font-size: 64px;
    font-weight: 500;
    margin: 0;
  }

  .showcase-wrapper {
    max-width: 1400px;
    padding: 0 50px;
    margin: 0 auto;
    width: 100%;
    overflow: hidden;
  }

  @media screen and (max-width: 768px) {
    .showcase-wrapper {
      padding: 0 16px;
    }
  }

  .showcase-container {
    position: relative;
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    perspective: 600px;
  }

  .showcase-scene {
    position: relative;
    width: 25vw;
    aspect-ratio: {{ section.settings.svg_mask.aspect_ratio | default: 0.75 }};
    transform-style: preserve-3d;
    will-change: transform;
    margin: 0 auto;
  }

  .showcase-item {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
  }

  .showcase-media-container {
    width: 100%;
    height: 100%;
    position: relative;
    background: #f4f4f4;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(0,0,0,0.2);
    
    {% if section.settings.svg_mask != blank %}
      -webkit-mask-image: url('{{ section.settings.svg_mask | image_url }}');
      mask-image: url('{{ section.settings.svg_mask | image_url }}');
      -webkit-mask-size: 100% 100%;
      mask-size: 100% 100%;
      -webkit-mask-repeat: no-repeat;
      mask-repeat: no-repeat;
      -webkit-mask-position: center;
      mask-position: center;
      border-radius: 0;
      box-shadow: none;
    {% endif %}
  }

  .showcase-media {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .showcase-caption {
    position: absolute;
    bottom: -80px;
    left: 0;
    width: 100%;
    text-align: center;
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.5s ease, transform 0.5s ease;
    pointer-events: none;
  }

  .showcase-caption h3 {
    margin: 0;
    font-family: 'Pally Variable', sans-serif;
    font-size: 20px;
    font-weight: 600;
    color: #fff;
  }

  .showcase-item.active .showcase-caption {
    opacity: 1;
    transform: translateY(0);
  }

  @media screen and (max-width: 768px) {
    .showcase-header h2 {
      font-size: 40px;
    }
    .showcase-scene {
      width: 40vw; 
    }
    .showcase-caption h3 {
      font-size: 16px;
    }
  }
{%- endstyle -%}

<div class="section-{{ section.id }}-padding">
  {%- if section.settings.title != blank -%}
    <div class="showcase-header">
      <h2>{{ section.settings.title | escape }}</h2>
    </div>
  {%- endif -%}

  <div class="showcase-wrapper">
    <showcase-carousel class="showcase-container"
      data-overlap-desktop="{{ section.settings.overlap_desktop }}"
      data-overlap-mobile="{{ section.settings.overlap_mobile }}">
      <div class="showcase-scene">
      {%- for block in section.blocks -%}
        <div class="showcase-item" {{ block.shopify_attributes }}>
          <div class="showcase-media-container">
            {%- if block.settings.video != blank -%}
              {{ block.settings.video | video_tag: image_size: '800x', autoplay: true, loop: true, muted: true, class: 'showcase-media' }}
            {%- elsif block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 800 }}" 
                   alt="{{ block.settings.image.alt | escape }}" 
                   class="showcase-media"
                   loading="lazy">
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'showcase-media placeholder-svg' }}
            {%- endif -%}
          </div>
          
          <div class="showcase-caption">
            {%- if block.settings.caption != blank -%}
              <h3>{{ block.settings.caption | escape }}</h3>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </showcase-carousel>
  </div>
</div>

<script>
  if (!customElements.get('showcase-carousel')) {
    class ShowcaseCarousel extends HTMLElement {
      constructor() {
        super();
        this.scene = this.querySelector('.showcase-scene');
        this.items = this.querySelectorAll('.showcase-item');
        if (!this.scene || this.items.length === 0) return;

        let minItems = 10;
        if (this.items.length > 0 && this.items.length < minItems) {
          let cloneCount = Math.ceil(minItems / this.items.length);
          let originalItems = Array.from(this.items);
          for (let i = 1; i < cloneCount; i++) {
            originalItems.forEach(item => {
              const clone = item.cloneNode(true);
              clone.classList.remove('active');
              this.scene.appendChild(clone);
            });
          }
          this.items = this.querySelectorAll('.showcase-item');
        }
        
        this.numItems = this.items.length;
        this.progress = 0;
        this.targetProgress = 0;
        this.isDragging = false;
        this.startX = 0;
        this.progressAtStart = 0;
        this.isMobile = window.innerWidth <= 768;

        this.init();
        this.setupEvents();
        
        this.animate = this.animate.bind(this);
        requestAnimationFrame(this.animate);
      }

      init() {
        this.isMobile = window.innerWidth <= 768;
        const containerWidth = this.offsetWidth || this.getBoundingClientRect().width; 
        
        const overlapDesktop = parseFloat(this.getAttribute('data-overlap-desktop')) || 30;
        const overlapMobile = parseFloat(this.getAttribute('data-overlap-mobile')) || 30;
        
        // Base size mapping: 0% overlap = smaller items (gaps), 100% = large items (heavy overlap)
        const minDesktop = 0.15, maxDesktop = 0.50;
        const minMobile = 0.30, maxMobile = 0.80;
        
        let itemWidthRatio;
        if (this.isMobile) {
          itemWidthRatio = minMobile + (overlapMobile / 100) * (maxMobile - minMobile);
        } else {
          itemWidthRatio = minDesktop + (overlapDesktop / 100) * (maxDesktop - minDesktop);
        }

        const itemWidth = containerWidth * itemWidthRatio;
        this.scene.style.width = `${itemWidth}px`;
        
        this.anglePerItem = this.isMobile ? 45 : 30;
        this.maxAngle = this.isMobile ? 45 : 60;
        const maxAngleRad = this.maxAngle * Math.PI / 180;
        
        // Deep Z depth for aggressive perspective shrinking
        this.radiusZ = containerWidth * (this.isMobile ? 1.5 : 0.8);
        
        // Calculate EXACT visual scale of the outermost item so we can snap its edge perfectly to the container bounds
        const perspective = 600;
        const zAtMaxAngle = Math.cos(maxAngleRad) * this.radiusZ - this.radiusZ;
        const scaleAtMaxAngle = perspective / (perspective - zAtMaxAngle);
        
        const availableHalfWidth = (containerWidth / 2) - (itemWidth / 2) * scaleAtMaxAngle;
        this.visualRadiusX = availableHalfWidth / Math.sin(maxAngleRad);
        
        this.updateActiveItem();
      }

      setupEvents() {
        let resizeTimer;
        window.addEventListener('resize', () => {
          clearTimeout(resizeTimer);
          resizeTimer = setTimeout(() => this.init(), 100);
        });

        this.addEventListener('mousemove', (e) => {
          if (this.isDragging || this.isMobile) return;
          
          const rect = this.getBoundingClientRect();
          const centerX = rect.left + rect.width / 2;
          const normalizedX = (e.clientX - centerX) / (rect.width / 2);
          const clampedX = Math.max(-1, Math.min(1, normalizedX));
          
          const maxProgress = this.numItems / 2;
          this.targetProgress = clampedX * maxProgress;
        });

        this.addEventListener('mouseleave', () => {
          if (!this.isMobile) {
            this.targetProgress = 0;
          }
        });

        this.addEventListener('touchstart', (e) => {
          this.isDragging = true;
          this.startX = e.touches[0].clientX;
          this.progressAtStart = this.targetProgress;
        }, { passive: true });

        this.addEventListener('touchmove', (e) => {
          if (!this.isDragging) return;
          const currentX = e.touches[0].clientX;
          const diff = currentX - this.startX;
          
          const itemsPerPixel = -0.01;
          this.targetProgress = this.progressAtStart + (diff * itemsPerPixel);
        }, { passive: true });

        this.addEventListener('touchend', () => {
          this.isDragging = false;
          this.targetProgress = Math.round(this.targetProgress);
        });
      }

      updateActiveItem() {
        let activeIndex = Math.round(this.progress) % this.numItems;
        if (activeIndex < 0) activeIndex += this.numItems;

        this.items.forEach((item, index) => {
          if (index === activeIndex) {
            item.classList.add('active');
          } else {
            item.classList.remove('active');
          }
        });
      }

      animate() {
        const ease = 0.08;
        const diff = this.targetProgress - this.progress;
        
        if (Math.abs(diff) > 0.001) {
          this.progress += diff * ease;
          this.updateActiveItem();
        }

        const perspective = 600;

        this.items.forEach((item, index) => {
          let relPos = index - this.progress;
          
          const half = this.numItems / 2;
          while (relPos > half) relPos -= this.numItems;
          while (relPos < -half) relPos += this.numItems;

          const angleDeg = relPos * this.anglePerItem;
          const angleRad = angleDeg * Math.PI / 180;
          
          let sinValue = Math.sin(angleRad);
          const maxSin = Math.sin(this.maxAngle * Math.PI / 180);
          
          // Push the extra leftmost and rightmost items a bit inside so they hide beautifully 
          // directly behind the outer visible items, without breaking the main circular system!
          if (Math.abs(sinValue) > maxSin) {
             const excess = Math.abs(sinValue) - maxSin;
             const sign = Math.sign(sinValue);
             sinValue = sign * (maxSin - (excess * 0.2)); 
          }
          
          const visual_x = sinValue * this.visualRadiusX;
          const z = Math.cos(angleRad) * this.radiusZ - this.radiusZ;
          const scale = perspective / (perspective - z);
          const local_x = visual_x / scale;
          
          item.style.transform = `translate3d(${local_x}px, 0, ${z}px)`;
          
          // Items remain 100% solid at all times!
          item.style.opacity = 1;
          item.style.visibility = 'visible';
        });

        requestAnimationFrame(this.animate);
      }
    }
    customElements.define('showcase-carousel', ShowcaseCarousel);
  }
</script>
