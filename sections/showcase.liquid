{% schema %}
{
  "name": "Showcase Carousel",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Spin & See"
    },
    {
      "type": "image_picker",
      "id": "svg_mask",
      "label": "SVG Mask Image",
      "info": "Upload an SVG image. Its aspect ratio will automatically size the carousel items."
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video (HTML5)",
          "info": "Overrides image if provided."
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption Text",
          "default": "Caption text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Showcase Carousel",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: 60px;
    padding-bottom: 120px;
    overflow: hidden;
  }
  
  .showcase-header {
    text-align: center;
    margin-bottom: 60px;
  }
  .showcase-header h2 {
    font-size: 3rem;
    font-weight: 500;
    margin: 0;
  }

  .showcase-container {
    position: relative;
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    perspective: 1000px; /* Strong perspective for depth */
  }

  .showcase-scene {
    position: relative;
    width: min(30vw, 350px);
    aspect-ratio: {{ section.settings.svg_mask.aspect_ratio | default: 0.75 }};
    transform-style: preserve-3d;
    will-change: transform;
  }

  .showcase-item {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
  }

  .showcase-media-container {
    width: 100%;
    height: 100%;
    position: relative;
    background: #f4f4f4;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(0,0,0,0.2);
    
    {% if section.settings.svg_mask != blank %}
      -webkit-mask-image: url('{{ section.settings.svg_mask | image_url }}');
      mask-image: url('{{ section.settings.svg_mask | image_url }}');
      -webkit-mask-size: 100% 100%;
      mask-size: 100% 100%;
      -webkit-mask-repeat: no-repeat;
      mask-repeat: no-repeat;
      -webkit-mask-position: center;
      mask-position: center;
      border-radius: 0;
      box-shadow: none;
    {% endif %}
  }

  .showcase-media {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .showcase-caption {
    position: absolute;
    bottom: -80px;
    left: 0;
    width: 100%;
    text-align: center;
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.5s ease, transform 0.5s ease;
    pointer-events: none;
  }

  .showcase-caption h3 {
    margin: 0;
    font-family: 'Pally Variable', sans-serif;
    font-size: 20px;
    font-weight: 600;
    color: #000;
  }

  .showcase-item.active .showcase-caption {
    opacity: 1;
    transform: translateY(0);
  }

  @media screen and (max-width: 768px) {
    .showcase-header h2 {
      font-size: 2rem;
    }
    .showcase-scene {
      width: 55vw;
    }
    .showcase-caption h3 {
      font-size: 16px;
    }
  }
{%- endstyle -%}

<div class="section-{{ section.id }}-padding">
  {%- if section.settings.title != blank -%}
    <div class="showcase-header">
      <h2>{{ section.settings.title | escape }}</h2>
    </div>
  {%- endif -%}

  <showcase-carousel class="showcase-container">
    <div class="showcase-scene">
      {%- for block in section.blocks -%}
        <div class="showcase-item" {{ block.shopify_attributes }}>
          <div class="showcase-media-container">
            {%- if block.settings.video != blank -%}
              {{ block.settings.video | video_tag: image_size: '800x', autoplay: true, loop: true, muted: true, class: 'showcase-media' }}
            {%- elsif block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 800 }}" 
                   alt="{{ block.settings.image.alt | escape }}" 
                   class="showcase-media"
                   loading="lazy">
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'showcase-media placeholder-svg' }}
            {%- endif -%}
          </div>
          
          <div class="showcase-caption">
            {%- if block.settings.caption != blank -%}
              <h3>{{ block.settings.caption | escape }}</h3>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </showcase-carousel>
</div>

<script>
  if (!customElements.get('showcase-carousel')) {
    class ShowcaseCarousel extends HTMLElement {
      constructor() {
        super();
        this.scene = this.querySelector('.showcase-scene');
        this.items = this.querySelectorAll('.showcase-item');
        if (!this.scene || this.items.length === 0) return;

        // Ensure we have enough items for a continuous loop without visible popping.
        // We clone items dynamically if there are fewer than 10.
        let minItems = 10;
        if (this.items.length > 0 && this.items.length < minItems) {
          let cloneCount = Math.ceil(minItems / this.items.length);
          let originalItems = Array.from(this.items);
          for (let i = 1; i < cloneCount; i++) {
            originalItems.forEach(item => {
              const clone = item.cloneNode(true);
              clone.classList.remove('active');
              this.scene.appendChild(clone);
            });
          }
          this.items = this.querySelectorAll('.showcase-item');
        }
        
        this.numItems = this.items.length;
        
        this.progress = 0;
        this.targetProgress = 0;
        
        this.isDragging = false;
        this.startX = 0;
        this.progressAtStart = 0;
        this.isMobile = window.innerWidth <= 768;

        this.init();
        this.setupEvents();
        
        this.animate = this.animate.bind(this);
        requestAnimationFrame(this.animate);
      }

      init() {
        this.isMobile = window.innerWidth <= 768;
        const itemWidth = this.scene.offsetWidth;
        
        // Exact control over how many items are visible
        // Desktop: 30 deg means 5 items visible (0, 30, 60)
        // Mobile: 45 deg means 3 items visible (0, 45)
        this.anglePerItem = this.isMobile ? 45 : 30;
        this.radius = this.isMobile ? itemWidth * 1.3 : itemWidth * 1.5;
        
        this.updateActiveItem();
      }

      setupEvents() {
        let resizeTimer;
        window.addEventListener('resize', () => {
          clearTimeout(resizeTimer);
          resizeTimer = setTimeout(() => this.init(), 100);
        });

        this.addEventListener('mousemove', (e) => {
          if (this.isDragging || this.isMobile) return;
          
          const rect = this.getBoundingClientRect();
          const centerX = rect.left + rect.width / 2;
          const normalizedX = (e.clientX - centerX) / (rect.width / 2);
          const clampedX = Math.max(-1, Math.min(1, normalizedX));
          
          // Map screen width to the entire carousel loop
          const maxProgress = this.numItems / 2;
          this.targetProgress = clampedX * maxProgress;
        });

        this.addEventListener('mouseleave', () => {
          if (!this.isMobile) {
            this.targetProgress = 0;
          }
        });

        this.addEventListener('touchstart', (e) => {
          this.isDragging = true;
          this.startX = e.touches[0].clientX;
          this.progressAtStart = this.targetProgress;
        }, { passive: true });

        this.addEventListener('touchmove', (e) => {
          if (!this.isDragging) return;
          const currentX = e.touches[0].clientX;
          const diff = currentX - this.startX;
          
          const itemsPerPixel = -0.01;
          this.targetProgress = this.progressAtStart + (diff * itemsPerPixel);
        }, { passive: true });

        this.addEventListener('touchend', () => {
          this.isDragging = false;
          this.targetProgress = Math.round(this.targetProgress);
        });
      }

      updateActiveItem() {
        let activeIndex = Math.round(this.progress) % this.numItems;
        if (activeIndex < 0) activeIndex += this.numItems;

        this.items.forEach((item, index) => {
          if (index === activeIndex) {
            item.classList.add('active');
          } else {
            item.classList.remove('active');
          }
        });
      }

      animate() {
        const ease = 0.08;
        const diff = this.targetProgress - this.progress;
        
        if (Math.abs(diff) > 0.001) {
          this.progress += diff * ease;
          this.updateActiveItem();
        }

        this.items.forEach((item, index) => {
          // Calculate relative position to active item
          let relPos = index - this.progress;
          
          // Wrap infinitely around the circle
          const half = this.numItems / 2;
          while (relPos > half) relPos -= this.numItems;
          while (relPos < -half) relPos += this.numItems;

          const angleDeg = relPos * this.anglePerItem;
          const angleRad = angleDeg * Math.PI / 180;
          
          const x = Math.sin(angleRad) * this.radius;
          const z = Math.cos(angleRad) * this.radius - this.radius;
          
          item.style.transform = `translate3d(${x}px, 0, ${z}px)`;
          
          // Fade out items rotating into the background to hide the wrapping "pop"
          let alpha = 1;
          const absAngle = Math.abs(angleDeg);
          if (absAngle > 70) {
            alpha = Math.max(0, 1 - (absAngle - 70) / 10);
          }
          item.style.opacity = alpha;
          item.style.visibility = alpha > 0 ? 'visible' : 'hidden';
        });

        requestAnimationFrame(this.animate);
      }
    }
    customElements.define('showcase-carousel', ShowcaseCarousel);
  }
</script>
