<style type="text/css">
  .template-404 .title + * {
    margin-top: 1rem;
  }

  @media screen and (min-width: 750px) {
    .template-404 .title + * {
      margin-top: 2rem;
    }
  }
</style>

<div class="template-404 page-width page-margin center">
  <p>
    {{ 'templates.404.subtext' | t }}
  </p>
  <h1 class="title">
    {{ 'templates.404.title' | t }}
  </h1>
  {%- assign continue_shopping_label = 'general.continue_shopping' | t -%}
  {% render 'button-component',
    url: shop.url | append: '/#continue-shopping-target',
    label: continue_shopping_label,
    size: 'medium',
    onclick: "window.location.href = this.href; return false;"
  %}
</div>
