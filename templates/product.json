    "testimonials_8WWCED": {
      "type": "testimonials",
      "blocks": {
        "testimonial_jzFY4r": {
          "type": "testimonial",
          "settings": {
            "image": "shopify://shop_images/8_2.jpg",
            "quote": "\"These masks are my brains favourite black out curtain! The sleep masks from this collection were made creatively yet very economical, and the fabric is very soft and comfortable. Definitely been sleeping better with these on\"",
            "author": "Iris, Hyderabad"
          }
        },
        "testimonial_jbigpK": {
          "type": "testimonial",
          "settings": {
            "image": "shopify://shop_images/7-2.jpg",
            "quote": "\"Wearing this on King’s Day in the Netherlands—great design, great quality, and it definitely stands out in the crowd! 🇳🇱🧡\"",
            "author": "David, Netherlands"
          }
        },
        "testimonial_dWbQRj": {
          "type": "testimonial",
          "settings": {
            "image": "shopify://shop_images/1_1.jpg",
            "quote": "\"If I want to activate sleep mode, this mask gets it done. The material & texture of the mask is soft and comfortable, as the material is not thin & flimsy which helps in serving the primary purpose to block out artificial light or even sun light.\"",
            "author": "Conchita, Mumbai"
          }
        },
        "testimonial_yjkHkH": {
          "type": "testimonial",
          "settings": {
            "image": "shopify://shop_images/2-4.jpg",
            "quote": "\"This tee is cool and comfy in the best possible way. It’s nailed two of my favourite things together, a tank top that fits perfectly well and a quirky design of my home city Mumbai!\"",
            "author": "Neeta, Mumbai"
          }
        },
        "testimonial_FBX47e": {
          "type": "testimonial",
          "settings": {
            "image": "shopify://shop_images/3_1.jpg",
            "quote": "\"The sleep mask is such a hit in our house that finding it at bedtime has become a mini treasure hunt! 😄 Most of the time my little monkey has already hidden it for herself. She absolutely loves this Maptrip mask; the fabric is very soft, the band is adjustable, and the graphics are excellent\"",
            "author": "Divya, Mumbai"
          }
        }
      },
